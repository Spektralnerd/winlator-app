+/* Winlator: name and amount in the dialog, at most every PROGRESS_PERIOD ms (the dialog runs on the main thread) */
+static void reportISOProgress(const wchar_t* name) {
+    DWORD now = GetTickCount();
+    if (now - isoProgressTime < PROGRESS_PERIOD) return;
+    isoProgressTime = now;
+    wchar_t text[MAX_PATH + 32] = {0};
+    swprintf_s(text, MAX_PATH + 32, L"%ls (%u MB)", name, (unsigned)(isoBytesDone >> 20));
+    SendMessage(hwndDlg, MSG_PROGRESS, 0, (LPARAM)text);
+}
