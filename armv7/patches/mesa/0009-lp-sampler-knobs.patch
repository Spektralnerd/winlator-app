diff --git a/virgl-23.1.9/src/gallium/drivers/llvmpipe/lp_state_sampler.c b/virgl-23.1.9/src/gallium/drivers/llvmpipe/lp_state_sampler.c
index c316ddd..0aae2ae 100755
--- a/virgl-23.1.9/src/gallium/drivers/llvmpipe/lp_state_sampler.c
+++ b/virgl-23.1.9/src/gallium/drivers/llvmpipe/lp_state_sampler.c
@@ -30,6 +30,7 @@
  */
 
 #include "util/u_inlines.h"
+#include <stdlib.h>
 #include "util/u_memory.h"
 
 #include "draw/draw_context.h"
@@ -61,6 +62,29 @@ llvmpipe_create_sampler_state(struct pipe_context *pipe,
       state->min_img_filter = PIPE_TEX_FILTER_NEAREST;
    }
 
+   /* Winlator armv7: WINLATOR_LP_LOD_BIAS=<float> verschiebt die Mipmap-Wahl aller Texturen
+    * (positiv: kleinere Stufen, weniger Texel im Cache verfehlt, unschärfer).
+    * WINLATOR_LP_MAG_NEAREST=1 nimmt bei Vergrößerung Point-Sampling, lässt die Verkleinerung
+    * (Minifikation) aber bilinear; das ist billiger als LP_PERF=no_linear und flimmert weniger. */
+   {
+      static int have_env = -1;
+      static float lod_bias;
+      static int mag_nearest;
+      if (have_env < 0) {
+         const char *v = getenv("WINLATOR_LP_LOD_BIAS");
+         lod_bias = v ? (float)atof(v) : 0.0f;
+         if (lod_bias > 8.0f) lod_bias = 8.0f;
+         if (lod_bias < -8.0f) lod_bias = -8.0f;
+         v = getenv("WINLATOR_LP_MAG_NEAREST");
+         mag_nearest = v && v[0] == '1';
+         have_env = 1;
+      }
+      if (lod_bias != 0.0f && state->min_mip_filter != PIPE_TEX_MIPFILTER_NONE)
+         state->lod_bias += lod_bias;
+      if (mag_nearest)
+         state->mag_img_filter = PIPE_TEX_FILTER_NEAREST;
+   }
+
    return state;
 }
 
