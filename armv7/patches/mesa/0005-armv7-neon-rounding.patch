+++ b/virgl-23.1.9/src/gallium/auxiliary/gallivm/lp_bld_debug.h
@@ -48,6 +48,7 @@
 #define GALLIVM_PERF_NO_QUAD_LOD     (1 << 2)
 #define GALLIVM_PERF_NO_OPT          (1 << 3)
 #define GALLIVM_PERF_NO_AOS_SAMPLING (1 << 4)
+#define GALLIVM_PERF_ARCH_ROUNDING   (1 << 5)  /* Winlator armv7: LLVM-Rundung auf 32-Bit-ARM */
 
 #ifdef __cplusplus
 extern "C" {
diff --git a/virgl-23.1.9/src/gallium/auxiliary/gallivm/lp_bld_init.c b/virgl-23.1.9/src/gallium/auxiliary/gallivm/lp_bld_init.c
