+                                     const void *key, unsigned key_size,
+                                     const void *closest, unsigned closest_no,
+                                     unsigned closest_diff) __attribute__((weak));
+extern void winlator_diag_fs_cull(unsigned nr_variants, unsigned nr_instrs,
+                                  unsigned to_cull) __attribute__((weak));
+
