+            unsigned diff = 0;
+            for (unsigned i = 0; i < shader->variant_key_size; i++)
+               diff += a[i] != b[i];
+            if (diff < closest_diff) {
+               closest_diff = diff;
+               closest = li->base;
+            }
+         }
+         winlator_diag_fs_variant(shader->no, shader->variants_created,
+                                  lp->nr_fs_variants, lp->nr_fs_instrs,
+                                  key, shader->variant_key_size,
+                                  closest ? (const void *)&closest->key : NULL,
+                                  closest ? closest->no : 0,
+                                  closest ? closest_diff : 0);
+      }
