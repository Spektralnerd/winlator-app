+         /* die ähnlichste vorhandene Variante dieses Shaders suchen */
+         const struct lp_fragment_shader_variant *closest = NULL;
+         unsigned closest_diff = ~0u;
+         LIST_FOR_EACH_ENTRY(li, &shader->variants.list, list) {
+            const unsigned char *a = (const unsigned char *)&li->base->key;
