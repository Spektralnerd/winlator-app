+/**
+ * Compile a module.
+ * This does IR optimization on all functions in the module.
+ */
+void
+gallivm_compile_module(struct gallivm_state *gallivm)
+{
+   assert(!gallivm->compiled);
+
+   if (winlator_diag_compile_begin)
+      winlator_diag_compile_begin(gallivm->module_name);
+
+   lp_call_with_stack(gallivm_compile_module_llvm, gallivm);
+}
