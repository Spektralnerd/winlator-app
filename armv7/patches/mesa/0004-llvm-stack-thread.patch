+/* Winlator armv7: LLVM braucht viel Stapel; beim Erzeugen des Maschinencodes legt
+ * ARMAsmPrinter::emitAttributes allein ein ARMSubtarget von einigen hundert KB darauf. Unter
+ * Box86 und Wine hat der Thread, der GL aufruft, manchmal nur wenig nativen Stapel: der
+ * Hauptthread, wenn Wine den Adressraum darunter reserviert hat (auf dem Gerät ~190 KB),
+ * Wine-Threads so viel wie ihr Windows-Stapel. LLVM lief dann über, das Programm fing den
+ * Absturz ab, die Übersetzung brach ab und llvmpipe versuchte es beim nächsten Zeichnen neu
+ * (schwarzes Bild, am Ende kein Speicher mehr). Deshalb übersetzt in diesem Fall ein
+ * Hilfsthread mit großem Stapel; der Aufrufer wartet auf ihn.
+ * WINLATOR_LLVM_THREAD=1: immer, =0: nie, sonst bei weniger als 2 MB freiem Stapel. */
+#include <pthread.h>
+#include <signal.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <unistd.h>
+#include <sys/syscall.h>
+
+#define LP_STACK_MIN_ROOM (2u << 20)
+#define LP_STACK_HELPER   (8u << 20)
+
+static __thread uintptr_t lp_stack_low;   /* untere Grenze des Stapels dieses Threads */
+static __thread int lp_stack_checked;
+
+/* freier Stapel ab hier; SIZE_MAX, wenn unbekannt */
+static size_t
+lp_stack_room(void)
+{
+   uintptr_t sp = (uintptr_t)__builtin_frame_address(0);
+
+   if (!lp_stack_checked) {
+      pthread_attr_t attr;
+      void *lo;
+      size_t size;
+
+      lp_stack_checked = 1;
+      /* glibc: beim Hauptthread aus /proc/self/maps, begrenzt durch den Bereich darunter */
+      if (pthread_getattr_np(pthread_self(), &attr) == 0) {
+         if (pthread_attr_getstack(&attr, &lo, &size) == 0 && (uintptr_t)lo < sp)
+            lp_stack_low = (uintptr_t)lo;
+         pthread_attr_destroy(&attr);
+      }
+   }
+   if (!lp_stack_low || sp <= lp_stack_low)
+      return SIZE_MAX;
+   return sp - lp_stack_low;
+}
+
+struct lp_stack_call {
+   void (*func)(void *);
+   void *data;
+};
+
+static void *
+lp_stack_thread(void *arg)
+{
+   struct lp_stack_call *call = arg;
+   call->func(call->data);
+   return NULL;
+}
+
+static void
+lp_stack_note(size_t room, int forced)
+{
+   static int noted;
+   const char *diag = getenv("WINLATOR_DIAG");
+
+   if (__atomic_exchange_n(&noted, 1, __ATOMIC_RELAXED) || (diag && diag[0] == '0'))
+      return;
+   if (forced)
+      fprintf(stderr, "[diag] llvmpipe: LLVM übersetzt in einem Hilfsthread mit %u MB Stapel "
+              "(WINLATOR_LLVM_THREAD=1)\n", LP_STACK_HELPER >> 20);
+   else
+      fprintf(stderr, "[diag] llvmpipe: Thread %ld hat nur %u KB Stapel frei, LLVM übersetzt "
+              "in einem Hilfsthread mit %u MB Stapel\n", (long)syscall(SYS_gettid),
+              (unsigned)(room >> 10), LP_STACK_HELPER >> 20);
+}
+
+/* func(data) mit genug Stapel ausführen */
+static void
+lp_call_with_stack(void (*func)(void *), void *data)
+{
+   static int mode = -2;   /* 1 immer, 0 nie, -1 nach Bedarf */
+   size_t room;
+
+   if (mode == -2) {
+      const char *v = getenv("WINLATOR_LLVM_THREAD");
+      mode = (v && v[0] == '1') ? 1 : (v && v[0] == '0') ? 0 : -1;
+   }
+   room = mode == 1 ? 0 : mode == 0 ? SIZE_MAX : lp_stack_room();
+   if (room >= LP_STACK_MIN_ROOM) {
+      func(data);
+      return;
+   }
+
+   struct lp_stack_call call = { func, data };
+   pthread_attr_t attr;
+   pthread_t thread;
+   sigset_t block, old;
+   int err;
+
+   pthread_attr_init(&attr);
+   pthread_attr_setstacksize(&attr, LP_STACK_HELPER);
+   /* Box86 und Wine kennen den Hilfsthread nicht: keine asynchronen Signale für ihn
+    * (Fehler wie SIGSEGV kommen weiter an und werden wie bisher gemeldet) */
+   sigfillset(&block);
+   sigdelset(&block, SIGSEGV);
+   sigdelset(&block, SIGBUS);
+   sigdelset(&block, SIGILL);
+   sigdelset(&block, SIGFPE);
+   sigdelset(&block, SIGTRAP);
+   sigdelset(&block, SIGABRT);
+   pthread_sigmask(SIG_BLOCK, &block, &old);
+   err = pthread_create(&thread, &attr, lp_stack_thread, &call);
+   pthread_sigmask(SIG_SETMASK, &old, NULL);
+   pthread_attr_destroy(&attr);
+   if (err) {
+      func(data);   /* kein Thread zu haben: wie bisher */
+      return;
+   }
+   lp_stack_note(room, mode == 1);
+   pthread_join(thread, NULL);
+}
