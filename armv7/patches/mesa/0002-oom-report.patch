+__attribute__((constructor)) void read_progress_setting()
+{
+   const char *v = getenv("WINLATOR_DIAG");
+   if (v && v[0] == '0')
+      progress_enabled = false;
+   if (progress_enabled) {
+      install_fault_handlers();
+      report_main_stack();
+      tls_write(0x5a17c0deu);
+      uint32_t got = tls_read();
+      if (got != 0x5a17c0deu) {
+         pthread_mutex_lock(&out_mutex);
+         begin_line();
+         put("TLS-Test: thread_local liefert ");
+         put_hex(got, 8);
+         put(" statt 5a17c0de");
+         end_line();
+         pthread_mutex_unlock(&out_mutex);
+      }
+   }
+}
