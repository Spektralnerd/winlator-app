+/* ---- WINLATOR_JIT_DUMP: LLVM-IR (nach der Optimierung) und Maschinencode jeder übersetzten
+ * Funktion als Dateien, zum Untersuchen langsamer Shader. Wert: Ordner (absolut) oder "1" für
+ * <Ordner von BOX86_TRACE_FILE>/../jit bzw. Documents/Winlator/jit. Schaltet den Shader-Cache ab,
+ * damit jeder Shader wirklich übersetzt wird. ---- */
+char jit_dump_dir[256];
+
+void make_dirs(const char *path)
+{
+   char tmp[256];
+   size_t n = strlen(path);
+   if (n >= sizeof(tmp))
+      return;
+   memcpy(tmp, path, n + 1);
+   for (size_t i = 1; i < n; i++) {
+      if (tmp[i] == '/') {
+         tmp[i] = 0;
+         mkdir(tmp, 0777);
+         tmp[i] = '/';
+      }
+   }
+   mkdir(tmp, 0777);
+}
+
+__attribute__((constructor)) void read_jit_dump_setting()
+{
+   const char *v = getenv("WINLATOR_JIT_DUMP");
+   if (!v || !*v || !strcmp(v, "0"))
+      return;
+   if (v[0] == '/') {
+      snprintf(jit_dump_dir, sizeof(jit_dump_dir), "%s", v);
+   } else {
+      const char *trace = getenv("BOX86_TRACE_FILE");
+      const char *slash = trace ? strrchr(trace, '/') : nullptr;
+      if (slash && slash > trace) {
+         /* .../Documents/Winlator/trace/box86-%pid.txt -> .../Documents/Winlator/jit */
+         std::string dir(trace, (size_t)(slash - trace));
+         size_t up = dir.rfind('/');
+         if (up != std::string::npos && !strcmp(dir.c_str() + up, "/trace"))
+            dir.resize(up);
+         snprintf(jit_dump_dir, sizeof(jit_dump_dir), "%s/jit", dir.c_str());
+      } else {
+         snprintf(jit_dump_dir, sizeof(jit_dump_dir), "/storage/emulated/0/Documents/Winlator/jit");
+      }
+   }
+   make_dirs(jit_dump_dir);
+   setenv("MESA_SHADER_CACHE_DISABLE", "true", 1);
+   pthread_mutex_lock(&out_mutex);
+   begin_line();
+   put("JIT-Dump (IR und Maschinencode jedes Shaders) nach ");
+   put(jit_dump_dir);
+   put(", Shader-Cache abgeschaltet");
+   end_line();
+   pthread_mutex_unlock(&out_mutex);
+}
+
+void dump_file(const char *name, const char *suffix, const void *data, size_t size)
+{
+   char path[512];
+   snprintf(path, sizeof(path), "%s/%s%s", jit_dump_dir, name, suffix);
+   for (char *c = path + strlen(jit_dump_dir) + 1; *c; c++)
+      if (*c == '/' || *c == ':' || *c == ' ')
+         *c = '_';
+   int fd = open(path, O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC, 0666);
+   if (fd < 0)
+      return;
+   const char *p = (const char *)data;
+   while (size) {
+      ssize_t w = write(fd, p, size);
+      if (w < 0 && errno == EINTR)
+         continue;
+      if (w <= 0)
+         break;
+      p += w;
+      size -= (size_t)w;
+   }
+   close(fd);
+}
+
+void dump_jit_code(const char *module, const char *func, const void *code)
+{
+   uintptr_t lo, hi, start = (uintptr_t)code;
+   static char maps_copy[16384];   /* nur aus dem GL-Thread (Übersetzung) */
+   if (!find_mapping_in(start, &lo, &hi, maps_copy, sizeof(maps_copy)))
+      return;
+   size_t size = hi - start > 65536 ? 65536 : hi - start;
+   char name[160];
+   snprintf(name, sizeof(name), "%s.%s", module ? module : "?", func ? func : "?");
+   dump_file(name, ".bin", code, size);
+   /* Verzeichnis: Name, Adresse, gesicherte Länge */
+   char line[256];
+   int n = snprintf(line, sizeof(line), "%s %08lx %u\n", name, (unsigned long)start, (unsigned)size);
+   char path[300];
+   snprintf(path, sizeof(path), "%s/index.txt", jit_dump_dir);
+   int fd = open(path, O_WRONLY | O_CREAT | O_APPEND | O_CLOEXEC, 0666);
+   if (fd >= 0) {
+      ssize_t w = write(fd, line, (size_t)n);
+      (void)w;
+      close(fd);
+   }
+}
+
+/* übersetzte Funktion (lp_bld_init.c, gallivm_jit_function): für die Stichproben und den Dump */
+extern "C" void winlator_diag_jit(const char *module, const char *func, const void *code)
+{
+   if (profile_enabled && code)
+      jit_record(module, func, code);
+   if (jit_dump_dir[0] && code)
+      dump_jit_code(module, func, code);
+}
+
+/* LLVM-IR eines Moduls nach der Optimierung (lp_bld_init.c, nur mit WINLATOR_JIT_DUMP) */
+extern "C" int winlator_diag_ir_wanted(void)
+{
+   return jit_dump_dir[0] != 0;
+}
+
+extern "C" void winlator_diag_ir(const char *module, const char *ir)
+{
+   if (jit_dump_dir[0] && ir)
+      dump_file(module ? module : "?", ".ll", ir, strlen(ir));
+}
+
+/* Schritt der laufenden Übersetzung (lp_bld_init.c, lp_state_fs.c) */
+extern "C" void winlator_diag_step(unsigned step)
+{
+   compile_step.store(step, std::memory_order_relaxed);
+}
