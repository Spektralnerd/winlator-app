+/*
+ * Winlator armv7 (32 Bit): Diagnose für gescheiterte C++-Speicheranforderungen in der libGL.
+ *
+ * llvmpipe übersetzt Shader mit LLVM. LLVM fordert Speicher über operator new an und ist ohne
+ * Ausnahmebehandlung gebaut: Scheitert eine Anforderung, endet das Programm nur mit
+ * "terminate called after throwing an instance of 'std::bad_alloc'", ohne Hinweis auf die
+ * Ursache. Diese Datei ersetzt operator new für den Code in der libGL (die Symbole bleiben
+ * dank Versionsskript lokal). Scheitert eine Anforderung, stehen vorher im Protokoll:
+ *   - die angeforderte Größe und errno
+ *   - Speicherstand des Prozesses und des Systems, Grenzen (overcommit, max_map_count, rlimit)
+ *   - eine Übersicht des Adressraums (Lücken, größte Bereiche, Belegung je 16 MB)
+ *   - Rücksprungadressen in die libGL (Aufrufkette, auflösbar mit der Symboldatei aus dem Bau)
+ * Alle Zeilen beginnen mit "[diag]"; Winlator übernimmt sie immer ins Startprotokoll.
+ * Danach wirft operator new wie gewohnt std::bad_alloc; da niemand es abfängt, endet der Prozess
+ * (sofort mit _exit statt über abort, siehe terminate_now). Im Normalfall kostet das nichts.
+ * WINLATOR_OOM_TEST=n lässt zum Ausprobieren die n-te Anforderung scheitern.
+ * Kommt ohne malloc aus (es ist ja gerade keiner mehr zu haben).
+ *
+ * Außerdem Fortschritt (ebenfalls "[diag]"-Zeilen): übersetzte Shader mit Dauer, Bilder pro
+ * Sekunde, und ein Wachhund-Thread, der bei Stillstand (Übersetzung dauert, kein neues Bild)
+ * für jeden Thread Zustand, Kernel-Wartestelle, CPU-Zeit, Programmzähler und die
+ * Rücksprungadressen in die libGL ausgibt. WINLATOR_DIAG=0 schaltet den Fortschritt ab.
+ */
+#include <atomic>
+#include <cerrno>
+#include <cstddef>
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+#include <exception>
+#include <new>
+#include <typeinfo>
