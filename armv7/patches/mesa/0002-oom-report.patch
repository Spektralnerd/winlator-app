+/* llvmpipe legt für einen Shader eine weitere Variante an (lp_state_fs.c, ab der fünften):
+ * welche Bytes des Schlüssels sich von der ähnlichsten vorhandenen Variante unterscheiden.
+ * Aufbau des Schlüssels auf armhf (23.1.9): 0 depth, 4 stencil[2], 12 blend (16 rt[8]),
+ * 48 alpha, 52 Bitfelder (nr_cbufs ...), 60 zsbuf_format, 64 cbuf_format[8],
+ * 96 cbuf_nr_samples[8], 104 zsbuf/coverage/min_samples; ab 108 je Sampler 16 Byte
+ * (+0 sampler_state, +4 texture_state). */
+extern "C" void winlator_diag_fs_variant(unsigned shader_no, unsigned variant_no,
+                                         unsigned nr_variants, unsigned nr_instrs,
+                                         const void *key, unsigned key_size,
+                                         const void *closest, unsigned closest_no,
+                                         unsigned closest_diff)
+{
+   if (!progress_enabled)
+      return;
+   uint32_t nr = fs_variant_reports.fetch_add(1) + 1;
+   if (nr > 40)
+      return;
+   const unsigned char *k = (const unsigned char *)key, *c = (const unsigned char *)closest;
+   pthread_mutex_lock(&out_mutex);
+   begin_line();
+   put("llvmpipe: fs");
+   put_dec(shader_no);
+   put(" bekommt Variante ");
+   put_dec(variant_no);
+   put(" (alle Shader: ");
+   put_dec(nr_variants);
+   put(" Varianten, ");
+   put_dec(nr_instrs);
+   put(" Instruktionen), Schlüssel ");
+   put_dec(key_size);
+   put(" Byte; ");
+   if (!c) {
+      put("keine vorhandene Variante dieses Shaders (alle verworfen?)");
+   } else {
+      put("ähnlichste Variante ");
+      put_dec(closest_no);
+      put(" weicht in ");
+      put_dec(closest_diff);
+      put(" Byte ab:");
+      int shown = 0;
+      for (unsigned i = 0; i < key_size && shown < 24; i++) {
+         if (k[i] == c[i])
+            continue;
+         put(" +");
+         put_dec(i);
+         put(" ");
+         put_hex(c[i], 2);
+         put(">");
+         put_hex(k[i], 2);
+         shown++;
+      }
+   }
+   end_line();
+   /* beim ersten Mal den ganzen Schlüssel, zum Entschlüsseln aller Felder */
+   if (nr == 1) {
+      for (unsigned row = 0; row * 64 < key_size; row++) {
+         begin_line();
+         put("  Schlüssel ab ");
+         put_dec(row * 64);
+         put(":");
+         for (unsigned i = row * 64; i < key_size && i < row * 64 + 64; i++) {
+            if (i % 4 == 0)
+               put_char(' ');
+            put_hex(k[i], 2);
+         }
+         end_line();
+      }
+   }
+   pthread_mutex_unlock(&out_mutex);
+}
