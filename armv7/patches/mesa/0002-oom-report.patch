+/* Bereich aus /proc/self/maps, der addr enthält */
+bool find_mapping(uintptr_t addr, uintptr_t *lo, uintptr_t *hi)
+{
+   int fd = open("/proc/self/maps", O_RDONLY | O_CLOEXEC);
+   if (fd < 0)
+      return false;
+   bool found = false;
+   size_t have = 0;
+   while (!found) {
+      ssize_t r = read(fd, mapsbuf + have, sizeof(mapsbuf) - have);
+      if (r < 0 && errno == EINTR)
+         continue;
+      if (r <= 0)
+         break;
+      have += (size_t)r;
+      size_t pos = 0;
+      for (;;) {
+         const char *nl = (const char *)memchr(mapsbuf + pos, '\n', have - pos);
+         if (!nl)
+            break;
+         const char *p = mapsbuf + pos;
+         uintptr_t start = parse_hex(p);
+         if (*p == '-') {
+            p++;
+            uintptr_t end = parse_hex(p);
+            if (addr >= start && addr < end) {
+               *lo = start;
+               *hi = end;
+               found = true;
+               break;
+            }
+         }
+         pos = (size_t)(nl - mapsbuf) + 1;
+      }
+      memmove(mapsbuf, mapsbuf + pos, have - pos);
+      have -= pos;
+      if (have == sizeof(mapsbuf))
+         have = 0;
+   }
+   close(fd);
+   return found;
+}
+
+/* Datei aus /proc/self/task/<tid>/ lesen */
+size_t read_task_file(int tid, const char *name)
+{
+   char path[64] = "/proc/self/task/";
+   size_t n = strlen(path);
+   char num[16];
+   int i = 0;
+   do {
+      num[i++] = (char)('0' + tid % 10);
+      tid /= 10;
+   } while (tid);
+   while (i)
+      path[n++] = num[--i];
+   path[n++] = '/';
+   for (const char *q = name; *q && n < sizeof(path) - 1; q++)
+      path[n++] = *q;
+   path[n] = 0;
+   return read_small(path);
+}
+
+/* Programmzähler als datei+offset */
+void put_code_address(uintptr_t pc)
+{
+   Dl_info info;
+   if (pc && dladdr((void *)pc, &info) && info.dli_fname) {
+      const char *base = strrchr(info.dli_fname, '/');
+      put(base ? base + 1 : info.dli_fname);
+      put("+0x");
+      uintptr_t off = pc - (uintptr_t)info.dli_fbase;
+      int digits = 1;
+      while (digits < 8 && (off >> (digits * 4)))
+         digits++;
+      put_hex(off, digits);
+   } else {
+      put_hex(pc, 8);
+   }
+}
+
+/* Zustand aller Threads: für Stillstände (Übersetzung hängt, kein neues Bild) */
+int dumps_left = 3;
+
+void dump_threads()
+{
+   if (dumps_left <= 0)
+      return;
+   dumps_left--;
+   begin_line();
+   put("Threads (Zustand, Wartestelle im Kernel, CPU-Zeit, Programmzähler; darunter Rücksprünge in die libGL):");
+   end_line();
+   DIR *dir = opendir("/proc/self/task");
+   if (!dir) {
+      begin_line();
+      put("  /proc/self/task nicht lesbar");
+      end_line();
+      return;
+   }
+   int self = (int)syscall(SYS_gettid);
+   long ticks = sysconf(_SC_CLK_TCK);
+   if (ticks <= 0)
+      ticks = 100;
+   int count = 0;
+   struct dirent *entry;
+   while ((entry = readdir(dir)) && count < 48) {
+      if (entry->d_name[0] < '0' || entry->d_name[0] > '9')
+         continue;
+      int tid = atoi(entry->d_name);
+      count++;
+      if (!read_task_file(tid, "stat"))
+         continue;
+      /* "tid (name) S ...": Name zwischen der ersten '(' und der letzten ')' */
+      char *open_paren = strchr(filebuf, '(');
+      char *close_paren = strrchr(filebuf, ')');
+      if (!open_paren || !close_paren || close_paren < open_paren)
+         continue;
+      char comm[20];
+      size_t clen = (size_t)(close_paren - open_paren - 1);
+      if (clen > sizeof(comm) - 1)
+         clen = sizeof(comm) - 1;
+      memcpy(comm, open_paren + 1, clen);
+      comm[clen] = 0;
+      /* Felder ab dem Zustand (Feld 3): utime 14, stime 15, kstkesp 29, kstkeip 30 */
+      unsigned long long field[32];
+      memset(field, 0, sizeof(field));
+      char state = '?';
+      const char *q = close_paren + 1;
+      for (int f = 3; f <= 30 && *q; f++) {
+         while (*q == ' ')
+            q++;
+         if (f == 3)
+            state = *q;
+         else {
+            unsigned long long v = 0;
+            while (*q >= '0' && *q <= '9')
+               v = v * 10 + (unsigned long long)(*q++ - '0');
+            field[f] = v;
+         }
+         while (*q && *q != ' ')
+            q++;
+      }
+      unsigned long long cpu_ticks = field[14] + field[15];
+      uintptr_t esp = field[29] <= 0xffffffffull ? (uintptr_t)field[29] : 0;
+      uintptr_t eip = field[30] <= 0xffffffffull ? (uintptr_t)field[30] : 0;
+
+      begin_line();
+      put("  ");
+      put_dec((unsigned)tid);
+      put(" \"");
+      for (const char *c = comm; *c; c++)
+         put_char(*c >= 32 && *c < 127 ? *c : '?');
+      put("\" ");
+      put_char(state);
+      put(" ");
+      if (read_task_file(tid, "wchan") && filebuf[0] && filebuf[0] != '0')
+         put(filebuf);
+      else
+         put("-");
+      put(" CPU ");
+      put_ms((uint32_t)(cpu_ticks * 1000 / (unsigned long long)ticks));
+      if (tid == self) {
+         put(" (dieser Wachhund)");
+         end_line();
+         continue;
+      }
+      put(" pc ");
+      put_code_address(eip);
+      end_line();
+
+      uintptr_t lo, hi;
+      if (esp && gl_text_hi && find_mapping(esp, &lo, &hi)) {
+         if (hi - esp > 512 * 1024)
+            hi = esp + 512 * 1024;
+         begin_line();
+         put("    libGL:");
+         if (!scan_returns(esp, hi, 0, 24, 12))
+            put(" -");
+         end_line();
+      }
+   }
+   closedir(dir);
+}
+
+/* CPU-Zeit je Thread seit der letzten Zeile: zeigt, wer bremst (Spiel samt Box86, WineD3D,
+ * die Mal-Threads von llvmpipe ...). Prozent eines Kerns; dazu die Auslastung des ganzen
+ * Systems aus /proc/stat (auch X-Server, wineserver, Ton), falls lesbar. */
+struct thread_cpu {
+   int tid;
+   unsigned long long ticks;
+   unsigned delta;
+   char comm[16];
+};
+const int MAX_THREADS = 96;
+thread_cpu prev_cpu[MAX_THREADS], cur_cpu[MAX_THREADS];
+int prev_cpu_count;
+unsigned long long prev_sys_busy, prev_sys_total;
+
+bool read_sys_cpu(unsigned long long *busy, unsigned long long *total)
+{
+   if (!read_small("/proc/stat") || strncmp(filebuf, "cpu ", 4))
+      return false;
+   const char *q = filebuf + 4;
+   unsigned long long v[8] = {0};
+   for (int i = 0; i < 8; i++) {
+      while (*q == ' ')
+         q++;
+      while (*q >= '0' && *q <= '9')
+         v[i] = v[i] * 10 + (unsigned long long)(*q++ - '0');
+   }
+   /* user nice system idle iowait irq softirq steal */
+   *total = v[0] + v[1] + v[2] + v[3] + v[4] + v[5] + v[6] + v[7];
+   *busy = *total - v[3] - v[4];
+   return true;
+}
+
+void put_thread_cpu(uint32_t window_ms)
+{
+   DIR *dir = opendir("/proc/self/task");
+   if (!dir)
+      return;
+   long hz = sysconf(_SC_CLK_TCK);
+   if (hz <= 0)
+      hz = 100;
+   unsigned long long window_ticks = (unsigned long long)window_ms * (unsigned long long)hz / 1000;
+   if (!window_ticks)
+      window_ticks = 1;
+   int count = 0;
+   unsigned long long sum = 0;
+   struct dirent *entry;
+   while ((entry = readdir(dir)) && count < MAX_THREADS) {
+      if (entry->d_name[0] < '0' || entry->d_name[0] > '9')
+         continue;
+      int tid = atoi(entry->d_name);
+      if (!read_task_file(tid, "stat"))
+         continue;
+      char *open_paren = strchr(filebuf, '(');
+      char *close_paren = strrchr(filebuf, ')');
+      if (!open_paren || !close_paren || close_paren < open_paren)
+         continue;
+      thread_cpu &t = cur_cpu[count];
+      memset(&t, 0, sizeof(t));
+      size_t clen = (size_t)(close_paren - open_paren - 1);
+      if (clen > sizeof(t.comm) - 1)
+         clen = sizeof(t.comm) - 1;
+      memcpy(t.comm, open_paren + 1, clen);
+      /* utime (Feld 14) + stime (Feld 15) */
+      unsigned long long field[16] = {0};
+      const char *q = close_paren + 1;
+      for (int f = 3; f <= 15 && *q; f++) {
+         while (*q == ' ')
+            q++;
+         unsigned long long v = 0;
+         while (*q >= '0' && *q <= '9')
+            v = v * 10 + (unsigned long long)(*q++ - '0');
+         field[f] = v;
+         while (*q && *q != ' ')
+            q++;
+      }
+      t.tid = tid;
+      t.ticks = field[14] + field[15];
+      unsigned long long before = 0;
+      bool known = false;
+      for (int i = 0; i < prev_cpu_count; i++) {
+         if (prev_cpu[i].tid == tid) {
+            before = prev_cpu[i].ticks;
+            known = true;
+            break;
+         }
+      }
+      unsigned long long d = known && t.ticks >= before ? t.ticks - before : t.ticks;
+      if (d > window_ticks)
+         d = window_ticks;   /* neuer Thread: höchstens das Fenster */
+      t.delta = (unsigned)d;
+      sum += d;
+      count++;
+   }
+   closedir(dir);
+   bool first = prev_cpu_count == 0;
+   memcpy(prev_cpu, cur_cpu, sizeof(thread_cpu) * (size_t)count);
+   prev_cpu_count = count;
+   unsigned long long sys_busy = 0, sys_total = 0;
+   bool have_sys = read_sys_cpu(&sys_busy, &sys_total);
+   bool sys_ok = have_sys && prev_sys_total && sys_total > prev_sys_total;
+   unsigned long long dbusy = sys_ok ? sys_busy - prev_sys_busy : 0, dtotal = sys_ok ? sys_total - prev_sys_total : 0;
+   if (have_sys) {
+      prev_sys_busy = sys_busy;
+      prev_sys_total = sys_total;
+   }
+   if (first)
+      return;   /* erst ab der zweiten Messung gibt es Abstände */
+   /* die größten zuerst (einfaches Auswahlverfahren, wenige Einträge) */
+   begin_line();
+   put("CPU je Thread (Anteil eines Kerns): ");
+   for (int shown = 0; shown < 8; shown++) {
+      int best = -1;
+      for (int i = 0; i < count; i++)
+         if (cur_cpu[i].delta && (best < 0 || cur_cpu[i].delta > cur_cpu[best].delta))
+            best = i;
+      if (best < 0 || cur_cpu[best].delta * 100ull < window_ticks * 2ull)
+         break;   /* unter 2 % weglassen */
+      if (shown)
+         put(", ");
+      for (const char *c = cur_cpu[best].comm; *c; c++)
+         put_char(*c >= 32 && *c < 127 && *c != ',' ? *c : '?');
+      put(" ");
+      put_dec(cur_cpu[best].delta * 100ull / window_ticks);
+      put(" %");
+      cur_cpu[best].delta = 0;
+   }
+   put("; Prozess zusammen ");
+   put_dec(sum * 100ull / window_ticks);
+   put(" %");
+   long cpus = sysconf(_SC_NPROCESSORS_CONF);
+   if (sys_ok && dtotal && cpus > 0) {
+      put(", ganzes System ");
+      put_dec(dbusy * 100ull * (unsigned long long)cpus / dtotal);
+      put(" % von ");
+      put_dec((unsigned long long)cpus * 100ull);
+      put(" %");
+   }
+   end_line();
+}
