+void put_progress()
+{
+   put("bisher ");
+   put_dec(compiles.load());
+   put(" Shader übersetzt (zusammen ");
+   put_ms(compile_ms_total.load());
+   put(", Enden ");
+   put_dec(compile_end_calls.load());
+   uint32_t lost = compile_end_without_begin.load();
+   if (lost) {
+      put(", davon ohne Beginn im selben Thread ");
+      put_dec(lost);
+   }
+   put("), ");
+   put_dec(frames.load());
+   put(" Bilder");
+   uint32_t since = compile_since.load();
+   if (since) {
+      put(", gerade in Arbeit: Nr. ");
+      put_dec(compile_nr_now.load());
+      put(" ");
+      put(compile_name);
+      put(" seit ");
+      put_ms(elapsed(since, now_ms()));
+   }
+}
+
+void *watchdog_main(void *)
+{
+   prctl(PR_SET_NAME, "winlator-diag", 0, 0, 0);
+   pthread_mutex_lock(&out_mutex);
+   put_thread_cpu(1000);   /* Ausgangswerte merken */
+   pthread_mutex_unlock(&out_mutex);
+   uint32_t started = now_ms();
+   uint32_t window_start = started, window_frames = frames.load(), interval = 30000;
+   uint32_t window_compiles = compiles.load();
+   uint32_t compile_reported = 0;
+   bool stall_reported = false, nofirst_reported = false;
+   for (;;) {
+      sleep(1);
+      uint32_t t = now_ms();
+      uint32_t since = compile_since.load();
+      /* eine Übersetzung ohne Ende (z. B. Modul nie ausgeführt) blockiert die Prüfungen nicht ewig */
+      bool compiling = since && elapsed(since, t) < 120000;
+      uint32_t f = frames.load();
+      uint32_t last = last_frame_ms.load();
+      uint32_t first_compile = first_compile_ms.load();
+
+      /* eine Übersetzung dauert ungewöhnlich lange */
+      if (since && elapsed(since, t) >= 15000 && compile_reported != since) {
+         compile_reported = since;
+         pthread_mutex_lock(&out_mutex);
+         begin_line();
+         put("llvmpipe: Übersetzung dauert, ");
+         put_progress();
+         end_line();
+         dump_threads();
+         pthread_mutex_unlock(&out_mutex);
+      }
+
+      /* Bilder pro Sekunde (oder Stand, solange nur übersetzt wird) */
+      if (t - window_start >= interval) {
+         uint32_t n = f - window_frames;
+         uint32_t c = compiles.load();
+         if (!n && c != window_compiles) {
+            pthread_mutex_lock(&out_mutex);
+            begin_line();
+            put("in den letzten ");
+            put_dec((t - window_start) / 1000);
+            put(" s kein Bild, ");
+            put_dec(c - window_compiles);
+            put(" Übersetzungen; ");
+            put_progress();
+            end_line();
+            pthread_mutex_unlock(&out_mutex);
+         }
+         window_compiles = c;
+         if (n) {
+            pthread_mutex_lock(&out_mutex);
+            begin_line();
+            put_dec(n);
+            put(" Bilder in den letzten ");
+            put_dec((t - window_start) / 1000);
+            put(" s (");
+            uint32_t tenth = n * 10000u / (t - window_start);
+            put_dec(tenth / 10);
+            put_char(',');
+            put_dec(tenth % 10);
+            put(" pro Sekunde), ");
+            put_progress();
+            end_line();
+            pthread_mutex_unlock(&out_mutex);
+         }
+         pthread_mutex_lock(&out_mutex);
+         put_thread_cpu(t - window_start);
+         pthread_mutex_unlock(&out_mutex);
+         window_start = t;
+         window_frames = f;
+         if (t - started > 300000)
+            interval = 300000;
+      }
+
+      /* Bilder kamen, jetzt seit 15 s keins mehr (und es wird nicht übersetzt) */
+      if (last && !compiling && elapsed(last, t) >= 15000) {
+         if (!stall_reported) {
+            stall_reported = true;
+            pthread_mutex_lock(&out_mutex);
+            begin_line();
+            put("seit ");
+            put_ms(elapsed(last, t));
+            put(" kein neues Bild, ");
+            put_progress();
+            end_line();
+            dump_threads();
+            pthread_mutex_unlock(&out_mutex);
+         }
+      } else if (last && elapsed(last, t) < 15000) {
+         stall_reported = false;
+      }
+
+      /* noch nie ein Bild, 30 s nach dem ersten Shader */
+      if (!f && first_compile && !compiling && elapsed(first_compile, t) >= 30000 && !nofirst_reported) {
+         nofirst_reported = true;
+         pthread_mutex_lock(&out_mutex);
+         begin_line();
+         put("30 s nach dem ersten Shader noch kein Bild, ");
+         put_progress();
+         end_line();
+         dump_threads();
+         pthread_mutex_unlock(&out_mutex);
+      }
+   }
+   return nullptr;
+}
+
+void start_watchdog()
+{
+   if (watchdog_started.exchange(1))
+      return;
+   pthread_attr_t attr;
+   pthread_attr_init(&attr);
+   pthread_attr_setdetachstate(&attr, PTHREAD_CREATE_DETACHED);
+   pthread_attr_setstacksize(&attr, 256 * 1024);
+   pthread_t thread;
+   pthread_create(&thread, &attr, watchdog_main, nullptr);
+   pthread_attr_destroy(&attr);
+}
+
+void compile_begin(const char *name)
+{
+   if (!progress_enabled)
+      return;
+   /* die vorige Übersetzung ist nie fertig geworden (abgebrochen, z. B. Absturz, den das
+    * Programm abgefangen hat): melden, bei welchem Schritt */
+   if (compile_since.load() && unfinished_reports.fetch_add(1) < 5) {
+      pthread_mutex_lock(&out_mutex);
+      begin_line();
+      put("llvmpipe: Übersetzung Nr. ");
+      put_dec(compile_nr_now.load());
+      put(" ");
+      put(compile_name);
+      put(" endete nie, letzter Schritt ");
+      put(step_name(compile_step.load()));
+      end_line();
+      pthread_mutex_unlock(&out_mutex);
+   }
+   compile_step.store(1);
+   uint32_t t = now_ms() | 1;
+   uint32_t nr = compiles.fetch_add(1) + 1;
+   tl_compile_t0 = t;
+   tl_compile_nr = nr;
+   size_t i = 0;
+   for (; name && name[i] && i < sizeof(compile_name) - 1; i++)
+      compile_name[i] = name[i];
+   compile_name[i] = 0;
+   compile_nr_now.store(nr);
+   compile_since.store(t);
+   uint32_t zero = 0;
+   first_compile_ms.compare_exchange_strong(zero, t);
+   start_watchdog();
+}
+
+void compile_end(const char *name)
+{
+   if (!progress_enabled)
+      return;
+   compile_end_calls.fetch_add(1);
+   if (!tl_compile_t0) {
+      /* Beginn nicht in diesem Thread gesehen (oder thread_local defekt): einmal melden */
+      if (compile_end_without_begin.fetch_add(1) == 0) {
+         pthread_mutex_lock(&out_mutex);
+         begin_line();
+         put("llvmpipe: Ende von ");
+         put(name ? name : "?");
+         put(" ohne gemerkten Beginn in diesem Thread (thread_local?)");
+         end_line();
+         pthread_mutex_unlock(&out_mutex);
+      }
+      compile_since.store(0);
+      return;
+   }
+   uint32_t ms = elapsed(tl_compile_t0, now_ms());
+   uint32_t nr = tl_compile_nr;
+   tl_compile_t0 = 0;
+   compile_since.store(0);
+   uint32_t total = compile_ms_total.fetch_add(ms) + ms;
+   if (nr <= 40 || ms >= 3000 || nr % 100 == 0) {
+      pthread_mutex_lock(&out_mutex);
+      begin_line();
+      put("llvmpipe: Shader Nr. ");
+      put_dec(nr);
+      put(" ");
+      put(name ? name : "?");
+      put(" in ");
+      put_ms(ms);
+      put(" übersetzt");
+      if (nr % 100 == 0) {
+         put(", zusammen ");
+         put_ms(total);
+      }
+      end_line();
+      pthread_mutex_unlock(&out_mutex);
+   }
+}
+
+void frame_presented()
+{
+   if (!progress_enabled)
+      return;
+   uint32_t t = now_ms() | 1;
+   uint32_t n = frames.fetch_add(1) + 1;
+   last_frame_ms.store(t);
+   if (n == 1) {
+      pthread_mutex_lock(&out_mutex);
+      begin_line();
+      put("erstes Bild");
+      uint32_t first_compile = first_compile_ms.load();
+      if (first_compile) {
+         put(" ");
+         put_ms(elapsed(first_compile, t));
+         put(" nach dem ersten Shader");
+      }
+      put(", ");
+      put_progress();
+      end_line();
+      pthread_mutex_unlock(&out_mutex);
+      start_watchdog();
+   }
+}
+
+thread_local uint32_t tl_selftest;
+
+__attribute__((noinline)) void tls_write(uint32_t v)
+{
+   tl_selftest = v;
+   __asm__ volatile("" ::: "memory");
+}
+
+__attribute__((noinline)) uint32_t tls_read()
+{
+   __asm__ volatile("" ::: "memory");
+   return tl_selftest;
+}
+
+/* ---- Abstürze in der libGL: melden, dann an den bisherigen Handler (Box86) weiterreichen ----
+ * Box86 gibt Signale in nativem Code an Wine weiter; fängt das Programm die Ausnahme ab, läuft
+ * es einfach weiter und der abgebrochene GL-Aufruf bleibt unsichtbar. */
+struct sigaction old_actions[NSIG];
+std::atomic<int> fault_reports{0};
+char fault_line[400];
+
+void fault_put(size_t &n, const char *s)
+{
+   while (*s && n < sizeof(fault_line) - 2)
+      fault_line[n++] = *s++;
+}
+
+void fault_hex(size_t &n, uintptr_t v)
+{
+   char b[9];
+   for (int i = 7; i >= 0; i--) {
+      b[i] = hexdigits[v & 15];
+      v >>= 4;
+   }
+   b[8] = 0;
+   fault_put(n, b);
+}
+
+void fault_handler(int sig, siginfo_t *info, void *ctx)
+{
+   ucontext_t *uc = (ucontext_t *)ctx;
+   uintptr_t pc = uc ? (uintptr_t)uc->uc_mcontext.arm_pc : 0;
+   uintptr_t lr = uc ? (uintptr_t)uc->uc_mcontext.arm_lr : 0;
+   uintptr_t sp = uc ? (uintptr_t)uc->uc_mcontext.arm_sp : 0;
+   bool pc_gl = pc >= gl_text_lo && pc < gl_text_hi, lr_gl = lr >= gl_text_lo && lr < gl_text_hi;
+   if ((pc_gl || lr_gl) && fault_reports.fetch_add(1) < 3) {
+      int saved_errno = errno;
+      /* eigene Zeile (die gemeinsame könnte gerade im unterbrochenen Code in Benutzung sein) */
+      size_t n = 0;
+      fault_put(n, "[diag] Signal ");
+      char num[4] = {(char)('0' + sig / 10), (char)('0' + sig % 10), 0, 0};
+      fault_put(n, sig >= 10 ? num : num + 1);
+      fault_put(n, sig == SIGSEGV ? " (SIGSEGV)" : sig == SIGBUS ? " (SIGBUS)" : sig == SIGILL ? " (SIGILL)" : " ");
+      fault_put(n, " pc ");
+      fault_put(n, pc_gl ? "libGL+" : "");
+      fault_hex(n, pc_gl ? pc - gl_base : pc);
+      fault_put(n, " lr ");
+      fault_put(n, lr_gl ? "libGL+" : "");
+      fault_hex(n, lr_gl ? lr - gl_base : lr);
+      fault_put(n, " Zugriff ");
+      fault_hex(n, info ? (uintptr_t)info->si_addr : 0);
+      fault_put(n, " Schritt ");
+      fault_put(n, compile_since.load() ? step_name(compile_step.load()) : "-");
+      fault_put(n, " (");
+      fault_put(n, compile_name);
+      fault_put(n, ")\n");
+      ssize_t w = write(2, fault_line, n);
+      (void)w;
+      /* Aufrufkette mit der normalen Ausgabe, nur wenn frei (sonst hängt der Handler) */
+      if (!pthread_mutex_trylock(&out_mutex)) {
+         uintptr_t lo, hi;
+         begin_line();
+         put("  Aufrufkette:");
+         if (sp && find_mapping(sp, &lo, &hi)) {
+            if (hi - sp > 512 * 1024)
+               hi = sp + 512 * 1024;
+            if (!scan_returns(sp, hi, lr_gl ? lr : 0, 32, 10))
+               put(" -");
+         } else {
+            put(" Stapel nicht gefunden");
+         }
+         end_line();
+         pthread_mutex_unlock(&out_mutex);
+      }
+      errno = saved_errno;
+   }
+   /* weiterreichen wie ohne uns */
+   const struct sigaction *old = &old_actions[sig];
+   if (old->sa_flags & SA_SIGINFO) {
+      if (old->sa_sigaction)
+         old->sa_sigaction(sig, info, ctx);
+      return;
+   }
+   if (old->sa_handler == SIG_IGN)
+      return;
+   if (old->sa_handler == SIG_DFL) {
+      struct sigaction dfl;
+      memset(&dfl, 0, sizeof(dfl));
+      dfl.sa_handler = SIG_DFL;
+      sigaction(sig, &dfl, nullptr);
+      return; /* der Befehl wiederholt sich und endet dann wie ohne uns */
+   }
+   old->sa_handler(sig);
+}
+
+void install_fault_handlers()
+{
+   const int sigs[] = {SIGSEGV, SIGBUS, SIGILL, SIGFPE};
+   for (int sig : sigs) {
+      struct sigaction old;
+      if (sigaction(sig, nullptr, &old))
+         continue;
+      if ((old.sa_flags & SA_SIGINFO) && old.sa_sigaction == fault_handler)
+         continue;
+      old_actions[sig] = old;
+      struct sigaction sa = old;
+      sa.sa_sigaction = fault_handler;
+      sa.sa_flags |= SA_SIGINFO;
+      sigaction(sig, &sa, nullptr);
+   }
+}
