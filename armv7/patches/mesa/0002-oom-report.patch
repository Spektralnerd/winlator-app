+/* Zum Prüfen der Diagnose: WINLATOR_OOM_TEST=n lässt die n-te Anforderung scheitern */
+std::atomic<long> test_countdown{0};
+
+__attribute__((constructor)) void read_test_setting()
+{
+   const char *v = getenv("WINLATOR_OOM_TEST");
+   if (v)
+      test_countdown.store(strtol(v, nullptr, 10), std::memory_order_relaxed);
+}
+
+void *alloc_or_report(std::size_t size, uintptr_t caller)
+{
+   if (__builtin_expect(test_countdown.load(std::memory_order_relaxed) > 0, 0) &&
+       test_countdown.fetch_sub(1) == 1) {
+      report("Speicheranforderung (operator new, Test über WINLATOR_OOM_TEST)", size, ENOMEM, caller);
+      errno = ENOMEM;
+      return nullptr;
+   }
+   void *p = std::malloc(size ? size : 1);
+   if (__builtin_expect(!p, 0))
+      report("Speicheranforderung (operator new)", size, errno, caller);
+   return p;
+}
+
+/* Anforderungen, die in libstdc++ selbst scheitern (z. B. std::string), kommen hier an:
+ * melden, Handler abmelden, libstdc++ wirft dann wie gewohnt std::bad_alloc */
+void new_handler_report()
+{
+   std::set_new_handler(nullptr);
+   report("Speicheranforderung in libstdc++", 0, errno, (uintptr_t)__builtin_return_address(0));
+}
+
+/* Nicht abgefangene Ausnahme (LLVM fängt nichts ab): Statt abort() den Prozess sofort beenden.
+ * Ein SIGABRT verwandelt Wine unter Box86 in eine Windows-Ausnahme, danach hing das Programm
+ * in einer Endlosschleife (Ton lief weiter, Fenster blieb schwarz). */
+void terminate_now()
+{
+   lock_out_try();
+   begin_line();
+   put("std::terminate");
+   const std::type_info *type = abi::__cxa_current_exception_type();
+   if (type) {
+      put(" nach Ausnahme ");
+      put(type->name());
+   }
+   put(": Prozess wird beendet");
+   end_line();
+   _exit(134);
+}
+
+__attribute__((constructor)) void install_handlers()
+{
+   if (!std::get_new_handler())
+      std::set_new_handler(new_handler_report);
+   std::set_terminate(terminate_now);
+}
+
+} /* namespace */
+
+void *operator new(std::size_t size)
+{
+   void *p = alloc_or_report(size, (uintptr_t)__builtin_return_address(0));
+   if (!p)
+      throw std::bad_alloc();
+   return p;
+}
+
+void *operator new[](std::size_t size)
+{
+   void *p = alloc_or_report(size, (uintptr_t)__builtin_return_address(0));
+   if (!p)
+      throw std::bad_alloc();
+   return p;
+}
+
+void *operator new(std::size_t size, const std::nothrow_t &) noexcept
+{
+   return alloc_or_report(size, (uintptr_t)__builtin_return_address(0));
+}
+
+void *operator new[](std::size_t size, const std::nothrow_t &) noexcept
+{
+   return alloc_or_report(size, (uintptr_t)__builtin_return_address(0));
+}
+
+/* std::allocator<T>::allocate(n) mit n über max_size() (mehr als 2 GB) wirft über diese
+ * Funktion, ohne operator new aufzurufen: ein unsinnig großer Wert statt Speichermangel */
+namespace std {
+[[noreturn]] void __throw_bad_alloc();
+void __throw_bad_alloc()
+{
+   report("Anforderung über std::allocator (Anzahl größer als max_size)", 0, 0,
+          (uintptr_t)__builtin_return_address(0));
+   throw std::bad_alloc();
+}
