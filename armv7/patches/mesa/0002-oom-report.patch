+/* what: Art des Fehlschlags; size 0 = unbekannt */
+__attribute__((noinline)) void report(const char *what, std::size_t size, int err, uintptr_t caller)
+{
+   if (reported.exchange(1))
+      return;
+   bool locked = lock_out_try();
+   int dummy;
+   cur_sp = (uintptr_t)&dummy;
+
+   char tname[17];
+   memset(tname, 0, sizeof(tname));
+   prctl(PR_GET_NAME, tname, 0, 0, 0);
+
+   begin_line();
+   put("libGL: ");
+   put(what);
+   if (size) {
+      put(" über ");
+      put_size(size);
+      put(" (");
+      put_dec(size);
+      put(" Byte)");
+   }
+   put(" gescheitert, errno ");
+   put_dec((unsigned)err);
+   put(", Thread ");
+   put_dec((unsigned long long)syscall(SYS_gettid));
+   put(" \"");
+   put(tname);
+   put("\"");
+   end_line();
+
+   begin_line();
+   put("libGL bei ");
+   put_hex(gl_base, 8);
+   put(", build-id ");
+   put(gl_build_id[0] ? gl_build_id : "?");
+   end_line();
+
+   begin_line();
+   put("Prozess:");
+   if (read_small("/proc/self/status")) {
+      put_kb_value("VmPeak", "VmPeak");
+      put_kb_value("VmSize", "VmSize");
+      put_kb_value("VmRSS", "VmRSS");
+      put_kb_value("VmData", "VmData");
+      put_kb_value("VmLib", "VmLib");
+      put_kb_value("VmPTE", "VmPTE");
+      long long threads = find_value("Threads");
+      if (threads >= 0) {
+         put(" Threads ");
+         put_dec((unsigned long long)threads);
+      }
+   }
+   end_line();
+
+   begin_line();
+   put("System:");
+   if (read_small("/proc/meminfo")) {
+      put_kb_value("MemTotal", "MemTotal");
+      put_kb_value("MemFree", "MemFree");
+      put_kb_value("Cached", "Cached");
+      put_kb_value("SwapFree", "SwapFree");
+      put_kb_value("CommitLimit", "CommitLimit");
+      put_kb_value("Committed_AS", "Committed_AS");
+   }
+   end_line();
+
+   begin_line();
+   put("Grenzen:");
+   put_file_number("overcommit_memory", "/proc/sys/vm/overcommit_memory");
+   put_file_number("overcommit_ratio", "/proc/sys/vm/overcommit_ratio");
+   put_file_number("max_map_count", "/proc/sys/vm/max_map_count");
+   put_file_number("mmap_min_addr", "/proc/sys/vm/mmap_min_addr");
+   put_file_number("legacy_va_layout", "/proc/sys/vm/legacy_va_layout");
+   put_rlimit("RLIMIT_AS", RLIMIT_AS);
+   put_rlimit("RLIMIT_DATA", RLIMIT_DATA);
+   put_rlimit("RLIMIT_STACK", RLIMIT_STACK);
+   end_line();
+
+   scan_maps();
+   begin_line();
+   put("Adressraum: ");
+   put_dec(map_count);
+   put(" Bereiche, belegt ");
+   put_size(total_mapped);
+   put(", davon ohne Zugriff (reserviert) ");
+   put_size(total_none);
+   put(", Stapel dieses Threads");
+   if (stack_hi) {
+      put(" ");
+      put_hex(stack_lo, 8);
+      put("-");
+      put_hex(stack_hi, 8);
+   } else {
+      put(" ?");
+   }
+   end_line();
+
+   begin_line();
+   put("Größte Lücken:");
+   for (int i = 0; i < TOP && gaps[i].end; i++)
+      put_range(gaps[i], false);
+   end_line();
+
+   for (int half = 0; half < 2; half++) {
+      begin_line();
+      put(half ? "  " : "Größte Bereiche:");
+      for (int i = half * TOP / 2; i < (half + 1) * TOP / 2 && biggest[i].end; i++)
+         put_range(biggest[i], true);
+      end_line();
+   }
+
+   /* die zehn größten Summen je Name */
+   for (int row = 0; row < 2; row++) {
+      begin_line();
+      put(row ? "  " : "Summen je Name:");
+      for (int k = 0; k < 5; k++) {
+         int best = -1;
+         for (int i = 0; i < name_count; i++)
+            if (names[i].count && (best < 0 || names[i].size > names[best].size))
+               best = i;
+         if (best < 0)
+            break;
+         put(" ");
+         put(names[best].name);
+         put(" ");
+         put_size(names[best].size);
+         put("/");
+         put_dec(names[best].count);
+         names[best].count = 0; /* erledigt */
+      }
+      if (row && other_names.count) {
+         put(" (weitere Namen ");
+         put_size(other_names.size);
+         put(")");
+      }
+      end_line();
+   }
+
+   {
+      struct mallinfo2 mi = mallinfo2();
+      begin_line();
+      put("malloc: Arenen ");
+      put_size(mi.arena);
+      put(", davon belegt ");
+      put_size(mi.uordblks);
+      put(", frei ");
+      put_size(mi.fordblks);
+      put("; einzeln per mmap ");
+      put_size(mi.hblkhd);
+      put(" in ");
+      put_dec(mi.hblks);
+      put(" Blöcken");
+      end_line();
+   }
+
+   begin_line();
+   put("Belegung je 16 MB (. frei  , kaum  + teils  # voll  - teils reserviert  = voll reserviert):");
+   end_line();
+   for (unsigned row = 0; row < SLICES / 64; row++) {
+      begin_line();
+      put_hex((unsigned long long)row << (SLICE_SHIFT + 6), 8);
+      put(" ");
+      for (unsigned s = row * 64; s < (row + 1) * 64; s++) {
+         uint32_t used = slice_used[s], none = slice_none[s];
+         const uint32_t full = (1u << SLICE_SHIFT) - (1u << 20);
+         char c;
+         if (!used)
+            c = '.';
+         else if (used < (1u << 20))
+            c = ',';
+         else if (none * 2 >= used)
+            c = used >= full ? '=' : '-';
+         else
+            c = used >= full ? '#' : '+';
+         put_char(c);
+      }
+      end_line();
+   }
+
+   begin_line();
+   put("Stand: ");
+   put_progress();
+   end_line();
+
+   stack_scan(caller);
+   if (locked)
+      pthread_mutex_unlock(&out_mutex);
+}
