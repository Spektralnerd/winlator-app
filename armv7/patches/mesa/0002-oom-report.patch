+/* Bereich aus /proc/self/maps, der addr enthält (buf: eigener Puffer für andere Threads) */
+bool find_mapping_in(uintptr_t addr, uintptr_t *lo, uintptr_t *hi, char *buf, size_t bufsize);
+
+bool find_mapping(uintptr_t addr, uintptr_t *lo, uintptr_t *hi)
+{
+   return find_mapping_in(addr, lo, hi, mapsbuf, sizeof(mapsbuf));
+}
+
+bool find_mapping_in(uintptr_t addr, uintptr_t *lo, uintptr_t *hi, char *mapsbuf, size_t bufsize)
+{
+   int fd = open("/proc/self/maps", O_RDONLY | O_CLOEXEC);
+   if (fd < 0)
+      return false;
+   bool found = false;
+   size_t have = 0;
+   while (!found) {
+      ssize_t r = read(fd, mapsbuf + have, bufsize - have);
+      if (r < 0 && errno == EINTR)
+         continue;
+      if (r <= 0)
+         break;
+      have += (size_t)r;
+      size_t pos = 0;
+      for (;;) {
+         const char *nl = (const char *)memchr(mapsbuf + pos, '\n', have - pos);
+         if (!nl)
+            break;
+         const char *p = mapsbuf + pos;
+         uintptr_t start = parse_hex(p);
+         if (*p == '-') {
+            p++;
+            uintptr_t end = parse_hex(p);
+            if (addr >= start && addr < end) {
+               *lo = start;
+               *hi = end;
+               found = true;
+               break;
+            }
+         }
+         pos = (size_t)(nl - mapsbuf) + 1;
+      }
+      memmove(mapsbuf, mapsbuf + pos, have - pos);
+      have -= pos;
+      if (have == bufsize)
+         have = 0;
+   }
+   close(fd);
+   return found;
+}
+
+/* Datei aus /proc/self/task/<tid>/ lesen */
+size_t read_task_file(int tid, const char *name)
+{
+   char path[64] = "/proc/self/task/";
+   size_t n = strlen(path);
+   char num[16];
+   int i = 0;
+   do {
+      num[i++] = (char)('0' + tid % 10);
+      tid /= 10;
+   } while (tid);
+   while (i)
+      path[n++] = num[--i];
+   path[n++] = '/';
+   for (const char *q = name; *q && n < sizeof(path) - 1; q++)
+      path[n++] = *q;
+   path[n] = 0;
+   return read_small(path);
+}
+
+/* Programmzähler als datei+offset */
+void put_code_address(uintptr_t pc)
+{
+   Dl_info info;
+   if (pc && dladdr((void *)pc, &info) && info.dli_fname) {
+      const char *base = strrchr(info.dli_fname, '/');
+      put(base ? base + 1 : info.dli_fname);
+      put("+0x");
+      uintptr_t off = pc - (uintptr_t)info.dli_fbase;
+      int digits = 1;
+      while (digits < 8 && (off >> (digits * 4)))
+         digits++;
+      put_hex(off, digits);
+   } else {
+      put_hex(pc, 8);
+   }
+}
+
+/* Zustand aller Threads: für Stillstände (Übersetzung hängt, kein neues Bild) */
+int dumps_left = 3;
+
+void dump_threads()
+{
+   if (dumps_left <= 0)
+      return;
+   dumps_left--;
+   begin_line();
+   put("Threads (Zustand, Wartestelle im Kernel, CPU-Zeit, Programmzähler; darunter Rücksprünge in die libGL):");
+   end_line();
+   DIR *dir = opendir("/proc/self/task");
+   if (!dir) {
+      begin_line();
+      put("  /proc/self/task nicht lesbar");
+      end_line();
+      return;
+   }
+   int self = (int)syscall(SYS_gettid);
+   long ticks = sysconf(_SC_CLK_TCK);
+   if (ticks <= 0)
+      ticks = 100;
+   int count = 0;
+   struct dirent *entry;
+   while ((entry = readdir(dir)) && count < 48) {
+      if (entry->d_name[0] < '0' || entry->d_name[0] > '9')
+         continue;
+      int tid = atoi(entry->d_name);
+      count++;
+      if (!read_task_file(tid, "stat"))
+         continue;
+      /* "tid (name) S ...": Name zwischen der ersten '(' und der letzten ')' */
+      char *open_paren = strchr(filebuf, '(');
+      char *close_paren = strrchr(filebuf, ')');
+      if (!open_paren || !close_paren || close_paren < open_paren)
+         continue;
+      char comm[20];
+      size_t clen = (size_t)(close_paren - open_paren - 1);
+      if (clen > sizeof(comm) - 1)
+         clen = sizeof(comm) - 1;
+      memcpy(comm, open_paren + 1, clen);
+      comm[clen] = 0;
+      /* Felder ab dem Zustand (Feld 3): utime 14, stime 15, kstkesp 29, kstkeip 30 */
+      unsigned long long field[32];
+      memset(field, 0, sizeof(field));
+      char state = '?';
+      const char *q = close_paren + 1;
+      for (int f = 3; f <= 30 && *q; f++) {
+         while (*q == ' ')
+            q++;
+         if (f == 3)
+            state = *q;
+         else {
+            unsigned long long v = 0;
+            while (*q >= '0' && *q <= '9')
+               v = v * 10 + (unsigned long long)(*q++ - '0');
+            field[f] = v;
+         }
+         while (*q && *q != ' ')
+            q++;
+      }
+      unsigned long long cpu_ticks = field[14] + field[15];
+      uintptr_t esp = field[29] <= 0xffffffffull ? (uintptr_t)field[29] : 0;
+      uintptr_t eip = field[30] <= 0xffffffffull ? (uintptr_t)field[30] : 0;
+
+      begin_line();
+      put("  ");
+      put_dec((unsigned)tid);
+      put(" \"");
+      for (const char *c = comm; *c; c++)
+         put_char(*c >= 32 && *c < 127 ? *c : '?');
+      put("\" ");
+      put_char(state);
+      put(" ");
+      if (read_task_file(tid, "wchan") && filebuf[0] && filebuf[0] != '0')
+         put(filebuf);
+      else
+         put("-");
+      put(" CPU ");
+      put_ms((uint32_t)(cpu_ticks * 1000 / (unsigned long long)ticks));
+      if (tid == self) {
+         put(" (dieser Wachhund)");
+         end_line();
+         continue;
+      }
+      put(" pc ");
+      put_code_address(eip);
+      end_line();
+
+      uintptr_t lo, hi;
+      if (esp && gl_text_hi && find_mapping(esp, &lo, &hi)) {
+         if (hi - esp > 512 * 1024)
+            hi = esp + 512 * 1024;
+         begin_line();
+         put("    libGL:");
+         if (!scan_returns(esp, hi, 0, 24, 12))
+            put(" -");
+         end_line();
+      }
+   }
+   closedir(dir);
+}
+
+/* CPU-Zeit je Thread seit der letzten Zeile: zeigt, wer bremst (Spiel samt Box86, WineD3D,
+ * die Mal-Threads von llvmpipe ...). Prozent eines Kerns; dazu die Auslastung des ganzen
+ * Systems aus /proc/stat (auch X-Server, wineserver, Ton), falls lesbar. */
+struct thread_cpu {
+   int tid;
+   unsigned long long ticks;
+   unsigned delta;
+   char comm[16];
+};
+const int MAX_THREADS = 96;
+thread_cpu prev_cpu[MAX_THREADS], cur_cpu[MAX_THREADS];
+int prev_cpu_count;
+unsigned long long prev_sys_busy, prev_sys_total;
+
+bool read_sys_cpu(unsigned long long *busy, unsigned long long *total)
+{
+   if (!read_small("/proc/stat") || strncmp(filebuf, "cpu ", 4))
+      return false;
+   const char *q = filebuf + 4;
+   unsigned long long v[8] = {0};
+   for (int i = 0; i < 8; i++) {
+      while (*q == ' ')
+         q++;
+      while (*q >= '0' && *q <= '9')
+         v[i] = v[i] * 10 + (unsigned long long)(*q++ - '0');
+   }
+   /* user nice system idle iowait irq softirq steal */
+   *total = v[0] + v[1] + v[2] + v[3] + v[4] + v[5] + v[6] + v[7];
+   *busy = *total - v[3] - v[4];
+   return true;
+}
+
+void put_thread_cpu(uint32_t window_ms)
+{
+   DIR *dir = opendir("/proc/self/task");
+   if (!dir)
+      return;
+   long hz = sysconf(_SC_CLK_TCK);
+   if (hz <= 0)
+      hz = 100;
+   unsigned long long window_ticks = (unsigned long long)window_ms * (unsigned long long)hz / 1000;
+   if (!window_ticks)
+      window_ticks = 1;
+   int count = 0;
+   unsigned long long sum = 0;
+   struct dirent *entry;
+   while ((entry = readdir(dir)) && count < MAX_THREADS) {
+      if (entry->d_name[0] < '0' || entry->d_name[0] > '9')
+         continue;
+      int tid = atoi(entry->d_name);
+      if (!read_task_file(tid, "stat"))
+         continue;
+      char *open_paren = strchr(filebuf, '(');
+      char *close_paren = strrchr(filebuf, ')');
+      if (!open_paren || !close_paren || close_paren < open_paren)
+         continue;
+      thread_cpu &t = cur_cpu[count];
+      memset(&t, 0, sizeof(t));
+      size_t clen = (size_t)(close_paren - open_paren - 1);
+      if (clen > sizeof(t.comm) - 1)
+         clen = sizeof(t.comm) - 1;
+      memcpy(t.comm, open_paren + 1, clen);
+      /* utime (Feld 14) + stime (Feld 15) */
+      unsigned long long field[16] = {0};
+      const char *q = close_paren + 1;
+      for (int f = 3; f <= 15 && *q; f++) {
+         while (*q == ' ')
+            q++;
+         unsigned long long v = 0;
+         while (*q >= '0' && *q <= '9')
+            v = v * 10 + (unsigned long long)(*q++ - '0');
+         field[f] = v;
+         while (*q && *q != ' ')
+            q++;
+      }
+      t.tid = tid;
+      t.ticks = field[14] + field[15];
+      unsigned long long before = 0;
+      bool known = false;
+      for (int i = 0; i < prev_cpu_count; i++) {
+         if (prev_cpu[i].tid == tid) {
+            before = prev_cpu[i].ticks;
+            known = true;
+            break;
+         }
+      }
+      unsigned long long d = known && t.ticks >= before ? t.ticks - before : t.ticks;
+      if (d > window_ticks)
+         d = window_ticks;   /* neuer Thread: höchstens das Fenster */
+      t.delta = (unsigned)d;
+      sum += d;
+      count++;
+   }
+   closedir(dir);
+   bool first = prev_cpu_count == 0;
+   memcpy(prev_cpu, cur_cpu, sizeof(thread_cpu) * (size_t)count);
+   prev_cpu_count = count;
+   unsigned long long sys_busy = 0, sys_total = 0;
+   bool have_sys = read_sys_cpu(&sys_busy, &sys_total);
+   bool sys_ok = have_sys && prev_sys_total && sys_total > prev_sys_total;
+   unsigned long long dbusy = sys_ok ? sys_busy - prev_sys_busy : 0, dtotal = sys_ok ? sys_total - prev_sys_total : 0;
+   if (have_sys) {
+      prev_sys_busy = sys_busy;
+      prev_sys_total = sys_total;
+   }
+   if (first)
+      return;   /* erst ab der zweiten Messung gibt es Abstände */
+   /* die größten zuerst (einfaches Auswahlverfahren, wenige Einträge) */
+   begin_line();
+   put("CPU je Thread (Anteil eines Kerns): ");
+   for (int shown = 0; shown < 8; shown++) {
+      int best = -1;
+      for (int i = 0; i < count; i++)
+         if (cur_cpu[i].delta && (best < 0 || cur_cpu[i].delta > cur_cpu[best].delta))
+            best = i;
+      if (best < 0 || cur_cpu[best].delta * 100ull < window_ticks * 2ull)
+         break;   /* unter 2 % weglassen */
+      if (shown)
+         put(", ");
+      for (const char *c = cur_cpu[best].comm; *c; c++)
+         put_char(*c >= 32 && *c < 127 && *c != ',' ? *c : '?');
+      put(" ");
+      put_dec(cur_cpu[best].delta * 100ull / window_ticks);
+      put(" %");
+      cur_cpu[best].delta = 0;
+   }
+   put("; Prozess zusammen ");
+   put_dec(sum * 100ull / window_ticks);
+   put(" %");
+   long cpus = sysconf(_SC_NPROCESSORS_CONF);
+   if (sys_ok && dtotal && cpus > 0) {
+      put(", ganzes System ");
+      put_dec(dbusy * 100ull * (unsigned long long)cpus / dtotal);
+      put(" % von ");
+      put_dec((unsigned long long)cpus * 100ull);
+      put(" %");
+   }
+   end_line();
+}
+
+/* ---- Stichproben: wo die Threads rechnen ----
+ * Kernel 3.0 trägt in /proc/self/task/<tid>/stat (Feld 30, kstkeip) den Programmzähler ein,
+ * den der Thread beim letzten Eintritt in den Kernel hatte (Zeitgeber-Interrupt, Systemaufruf).
+ * Der Thread "winlator-prof" liest das 50-mal pro Sekunde für die Mal-Threads von llvmpipe und
+ * für andere Threads mit nennenswerter CPU-Zeit (nur solche im Zustand R) und zählt, wo sie
+ * gerade sind: übersetzte Funktion (JIT, Name aus gallivm_jit_function), libGL+Offset (mit der
+ * Symboldatei auflösbar), andere Bibliothek mit Symbol, anonymer Code (Box86-Dynarec).
+ * Neuere Kernel liefern 0, dann bleibt die Rangliste leer. WINLATOR_PROFILE=0 schaltet ab. */
+struct jit_entry {
+   uintptr_t start;
+   char name[44];
+};
+const int MAX_JIT = 512;
+jit_entry jit_table[MAX_JIT];
+int jit_next, jit_used;
+pthread_mutex_t prof_mutex = PTHREAD_MUTEX_INITIALIZER;
+bool profile_enabled = true;
+
+void jit_record(const char *module, const char *func, const void *code)
+{
+   jit_entry e;
+   memset(&e, 0, sizeof(e));
+   e.start = (uintptr_t)code;
+   size_t n = 0;
+   for (const char *c = module ? module : "?"; *c && n < sizeof(e.name) - 1; c++)
+      e.name[n++] = *c;
+   /* fs_variant_whole/partial: Art anhängen; sonst ist der Modulname eindeutig genug */
+   if (func && !strncmp(func, "fs_variant_", 11) && n < sizeof(e.name) - 2) {
+      e.name[n++] = ':';
+      for (const char *c = func + 11; *c && n < sizeof(e.name) - 1; c++)
+         e.name[n++] = *c;
+   }
+   pthread_mutex_lock(&prof_mutex);
+   jit_table[jit_next] = e;
+   jit_next = (jit_next + 1) % MAX_JIT;
+   if (jit_used < MAX_JIT)
+      jit_used++;
+   pthread_mutex_unlock(&prof_mutex);
+}
+
+/* (prof_mutex gehalten) bekannte JIT-Funktion, die pc enthalten dürfte */
+const jit_entry *find_jit(uintptr_t pc)
+{
+   const jit_entry *best = nullptr;
+   for (int i = 0; i < jit_used; i++) {
+      const jit_entry &e = jit_table[i];
+      if (e.start && e.start <= pc && pc - e.start < 64 * 1024 && (!best || e.start >= best->start))
+         best = &e;
+   }
+   return best;
+}
+
+enum { K_JIT = 1, K_GL = 2, K_LIB = 3, K_ANON = 4, K_NONE = 5 };
+struct prof_bin {
+   uint64_t key;
+   uint32_t count;
+};
+const unsigned PROF_BINS = 1024;
+struct prof_hist {
+   prof_bin bins[PROF_BINS];
+   uint32_t total;
+};
+prof_hist prof_raster, prof_other;
+/* feiner: Stelle innerhalb der übersetzten Funktionen (32-Byte-Abschnitte), zum Abgleich mit
+ * dem Maschinencode aus WINLATOR_JIT_DUMP */
+prof_hist prof_jit_fine;
+const unsigned JIT_FINE_SHIFT = 5;
+
+void hist_add(prof_hist &h, uint64_t key)
+{
+   h.total++;
+   uint32_t i = (uint32_t)((key ^ (key >> 29)) * 2654435761u) & (PROF_BINS - 1);
+   for (unsigned probe = 0; probe < 64; probe++) {
+      prof_bin &b = h.bins[(i + probe) & (PROF_BINS - 1)];
+      if (b.count && b.key == key) {
+         b.count++;
+         return;
+      }
+      if (!b.count) {
+         b.key = key;
+         b.count = 1;
+         return;
+      }
+   }
+   /* voll: zählt nur in total */
+}
+
+void hist_add(prof_hist &h, uint64_t key);
+
+/* (prof_mutex gehalten) Stichprobe eintragen; JIT-Treffer auch nach Stelle in der Funktion */
+void prof_count(prof_hist &h, uint64_t key, uintptr_t pc)
+{
+   hist_add(h, key);
+   if ((unsigned)(key >> 32) == K_JIT) {
+      uintptr_t start = (uintptr_t)(key & 0xffffffffu);
+      hist_add(prof_jit_fine, ((uint64_t)start << 32) | ((pc - start) >> JIT_FINE_SHIFT));
+   }
+}
+
+uint64_t classify_pc(uintptr_t pc)
+{
+   if (!pc)
+      return (uint64_t)K_NONE << 32;
+   if (pc >= gl_text_lo && pc < gl_text_hi)
+      return ((uint64_t)K_GL << 32) | ((pc - gl_base) & ~(uintptr_t)0xff);
+   Dl_info info;
+   if (dladdr((void *)pc, &info) && info.dli_fbase) {
+      /* mit Symbol: nach Symbol zusammenfassen, sonst nach 256-Byte-Abschnitt */
+      uintptr_t where = info.dli_saddr ? (uintptr_t)info.dli_saddr : (pc & ~(uintptr_t)0xff);
+      return ((uint64_t)K_LIB << 32) | where;
+   }
+   pthread_mutex_lock(&prof_mutex);
+   const jit_entry *e = find_jit(pc);
+   uintptr_t start = e ? e->start : 0;
+   pthread_mutex_unlock(&prof_mutex);
+   if (start)
+      return ((uint64_t)K_JIT << 32) | start;
+   return (uint64_t)K_ANON << 32;
+}
+
+void put_prof_key(uint64_t key)
+{
+   unsigned kind = (unsigned)(key >> 32);
+   uintptr_t v = (uintptr_t)(key & 0xffffffffu);
+   switch (kind) {
+   case K_JIT: {
+      const char *name = nullptr;
+      pthread_mutex_lock(&prof_mutex);
+      for (int i = 0; i < jit_used; i++)
+         if (jit_table[i].start == v)
+            name = jit_table[i].name;
+      char copy[sizeof(jit_table[0].name)];
+      if (name) {
+         memcpy(copy, name, sizeof(copy));
+         name = copy;
+      }
+      pthread_mutex_unlock(&prof_mutex);
+      put(name ? name : "JIT?");
+      break;
+   }
+   case K_GL:
+      put("libGL+");
+      put_hex(v, 7);
+      break;
+   case K_LIB: {
+      Dl_info info;
+      if (dladdr((void *)v, &info) && info.dli_fname) {
+         const char *base = strrchr(info.dli_fname, '/');
+         base = base ? base + 1 : info.dli_fname;
+         put(*base ? base : "Programm");
+         if (info.dli_sname && (uintptr_t)info.dli_saddr == v) {
+            put(":");
+            put(info.dli_sname);
+         } else {
+            put("+");
+            put_hex(v - (uintptr_t)info.dli_fbase, 6);
+         }
+      } else {
+         put_hex(v, 8);
+      }
+      break;
+   }
+   case K_ANON:
+      put("anonym (Box86-Dynarec?)");
+      break;
+   default:
+      put("pc 0");
+   }
+}
+
+/* (out_mutex gehalten, fine = Kopie) Stellen innerhalb einer übersetzten Funktion */
+void put_jit_fine(prof_hist &fine, uintptr_t start, uint32_t func_count)
+{
+   begin_line();
+   put("    ");
+   uint64_t name_key = ((uint64_t)K_JIT << 32) | start;
+   put_prof_key(name_key);
+   put(" (");
+   put_dec(func_count);
+   put(" Stichproben, 32-Byte-Abschnitte):");
+   for (int shown = 0; shown < 12; shown++) {
+      int best = -1;
+      for (unsigned i = 0; i < PROF_BINS; i++) {
+         prof_bin &b = fine.bins[i];
+         if (b.count && (uintptr_t)(b.key >> 32) == start &&
+             (best < 0 || b.count > fine.bins[best].count))
+            best = (int)i;
+      }
+      if (best < 0 || fine.bins[best].count * 50ull < func_count)
+         break;   /* unter 2 % der Funktion weglassen */
+      put(" +");
+      put_hex((uint32_t)(fine.bins[best].key & 0xffffffffu) << JIT_FINE_SHIFT, 4);
+      put(" ");
+      put_dec(fine.bins[best].count * 100ull / func_count);
+      put(" %");
+      fine.bins[best].count = 0;
+   }
+   end_line();
+}
+
+/* (out_mutex gehalten) Rangliste ausgeben und leeren */
+void put_profile(prof_hist &h, const char *title)
+{
+   pthread_mutex_lock(&prof_mutex);
+   static prof_hist copy, fine;
+   copy = h;
+   memset(&h, 0, sizeof(h));
+   bool with_fine = &h == &prof_raster;
+   if (with_fine) {
+      fine = prof_jit_fine;
+      memset(&prof_jit_fine, 0, sizeof(prof_jit_fine));
+   }
+   pthread_mutex_unlock(&prof_mutex);
+   if (!copy.total)
+      return;
+   uintptr_t top_jit[3] = {0, 0, 0};
+   uint32_t top_jit_count[3] = {0, 0, 0};
+   int top_jits = 0;
+   begin_line();
+   put(title);
+   put(", ");
+   put_dec(copy.total);
+   put(" Stichproben:");
+   int on_line = 0;
+   for (int shown = 0; shown < 18; shown++) {
+      int best = -1;
+      for (unsigned i = 0; i < PROF_BINS; i++)
+         if (copy.bins[i].count && (best < 0 || copy.bins[i].count > copy.bins[best].count))
+            best = (int)i;
+      if (best < 0 || copy.bins[best].count * 200ull < copy.total)
+         break;   /* unter 0,5 % weglassen */
+      if (on_line == 6) {
+         end_line();
+         begin_line();
+         put("  ");
+         on_line = 0;
+      }
+      unsigned tenth = (unsigned)(copy.bins[best].count * 1000ull / copy.total);
+      put(" ");
+      put_dec(tenth / 10);
+      put_char(',');
+      put_dec(tenth % 10);
+      put(" % ");
+      put_prof_key(copy.bins[best].key);
+      put(";");
+      on_line++;
+      if (with_fine && top_jits < 3 && (unsigned)(copy.bins[best].key >> 32) == K_JIT) {
+         top_jit[top_jits] = (uintptr_t)(copy.bins[best].key & 0xffffffffu);
+         top_jit_count[top_jits++] = copy.bins[best].count;
+      }
+      copy.bins[best].count = 0;
+   }
+   end_line();
+   for (int i = 0; i < top_jits; i++)
+      put_jit_fine(fine, top_jit[i], top_jit_count[i]);
+}
+
+/* eine Zeile aus stat: Zustand, Name, CPU-Ticks, kstkeip */
+bool parse_task_stat(const char *buf, char *state, char *comm, size_t comm_size,
+                     unsigned long long *ticks, uintptr_t *eip)
+{
+   const char *open_paren = strchr(buf, '(');
+   const char *close_paren = strrchr(buf, ')');
+   if (!open_paren || !close_paren || close_paren < open_paren)
+      return false;
+   size_t clen = (size_t)(close_paren - open_paren - 1);
+   if (clen > comm_size - 1)
+      clen = comm_size - 1;
+   memcpy(comm, open_paren + 1, clen);
+   comm[clen] = 0;
+   unsigned long long field[32];
+   memset(field, 0, sizeof(field));
+   const char *q = close_paren + 1;
+   *state = '?';
+   for (int f = 3; f <= 30 && *q; f++) {
+      while (*q == ' ')
+         q++;
+      if (f == 3) {
+         *state = *q;
+      } else {
+         unsigned long long v = 0;
+         while (*q >= '0' && *q <= '9')
+            v = v * 10 + (unsigned long long)(*q++ - '0');
+         field[f] = v;
+      }
+      while (*q && *q != ' ')
+         q++;
+   }
+   *ticks = field[14] + field[15];
+   *eip = field[30] <= 0xffffffffull ? (uintptr_t)field[30] : 0;
+   return true;
+}
+
+size_t read_into(const char *path, char *buf, size_t size)
+{
+   buf[0] = 0;
+   int fd = open(path, O_RDONLY | O_CLOEXEC);
+   if (fd < 0)
+      return 0;
+   size_t n = 0;
+   while (n < size - 1) {
+      ssize_t r = read(fd, buf + n, size - 1 - n);
+      if (r < 0 && errno == EINTR)
+         continue;
+      if (r <= 0)
+         break;
+      n += (size_t)r;
+   }
+   close(fd);
+   buf[n] = 0;
+   return n;
+}
+
+void task_stat_path(char *path, int tid)
+{
+   char num[16];
+   int i = 0;
+   size_t n = 0;
+   const char *pre = "/proc/self/task/";
+   while (pre[n]) {
+      path[n] = pre[n];
+      n++;
+   }
+   do {
+      num[i++] = (char)('0' + tid % 10);
+      tid /= 10;
+   } while (tid);
+   while (i)
+      path[n++] = num[--i];
+   memcpy(path + n, "/stat", 6);
+}
+
+struct prof_task {
+   int tid;
+   unsigned long long ticks;
+   bool raster, sample;
+   int sent, got;   /* Signale an den Thread, angekommene Stichproben (Ausweichweg) */
+};
+prof_task prof_tasks[MAX_THREADS], prof_tasks_new[MAX_THREADS];
+int prof_task_count;
+
+/* einmal pro Sekunde: welche Threads abgefragt werden (llvmpipe-* immer, andere ab 5 % CPU) */
+void prof_refresh(int self, long hz, char *buf, size_t size)
+{
+   DIR *dir = opendir("/proc/self/task");
+   if (!dir)
+      return;
+   int count = 0;
+   struct dirent *entry;
+   while ((entry = readdir(dir)) && count < MAX_THREADS) {
+      if (entry->d_name[0] < '0' || entry->d_name[0] > '9')
+         continue;
+      int tid = atoi(entry->d_name);
+      if (tid == self)
+         continue;
+      char path[48];
+      task_stat_path(path, tid);
+      if (!read_into(path, buf, size))
+         continue;
+      char state, comm[16];
+      unsigned long long ticks;
+      uintptr_t eip;
+      if (!parse_task_stat(buf, &state, comm, sizeof(comm), &ticks, &eip))
+         continue;
+      if (!strcmp(comm, "winlator-diag"))
+         continue;
+      prof_task &t = prof_tasks_new[count++];
+      t.tid = tid;
+      t.ticks = ticks;
+      t.raster = !strncmp(comm, "llvmpipe", 8);
+      unsigned long long before = ticks;
+      t.sent = t.got = 0;
+      for (int i = 0; i < prof_task_count; i++) {
+         if (prof_tasks[i].tid == tid) {
+            before = prof_tasks[i].ticks;
+            t.sent = prof_tasks[i].sent;
+            t.got = prof_tasks[i].got;
+         }
+      }
+      t.sample = t.raster || (ticks >= before && (ticks - before) * 20 >= (unsigned long long)hz);
+   }
+   closedir(dir);
+   memcpy(prof_tasks, prof_tasks_new, sizeof(prof_task) * (size_t)count);
+   prof_task_count = count;
+}
+
+/* Ausweichweg, wenn der Kernel kein kstkeip liefert (neuere Kernel, qemu): ein Echtzeitsignal an
+ * den Thread, der Handler merkt sich den Programmzähler aus dem Kontext. */
+struct prof_sample {
+   std::atomic<int> tid;
+   uintptr_t pc;
+};
+const unsigned PROF_RING = 256;
+prof_sample prof_ring[PROF_RING];
+std::atomic<uint32_t> prof_ring_head{0};
+
+void prof_signal_handler(int, siginfo_t *, void *ctx)
+{
+   int saved_errno = errno;
+   ucontext_t *uc = (ucontext_t *)ctx;
+   uint32_t slot = prof_ring_head.fetch_add(1) % PROF_RING;
+   prof_ring[slot].pc = uc ? (uintptr_t)uc->uc_mcontext.arm_pc : 0;
+   prof_ring[slot].tid.store((int)syscall(SYS_gettid), std::memory_order_release);
+   errno = saved_errno;
+}
+
+bool install_prof_signal(int sig)
+{
+   struct sigaction old;
+   if (sigaction(sig, nullptr, &old))
+      return false;
+   if (!(old.sa_flags & SA_SIGINFO) && old.sa_handler != SIG_DFL)
+      return false;   /* schon von jemandem belegt */
+   if ((old.sa_flags & SA_SIGINFO) && old.sa_sigaction != prof_signal_handler)
+      return false;
+   struct sigaction sa;
+   memset(&sa, 0, sizeof(sa));
+   sa.sa_sigaction = prof_signal_handler;
+   sa.sa_flags = SA_SIGINFO | SA_RESTART;
+   sigemptyset(&sa.sa_mask);
+   return !sigaction(sig, &sa, nullptr);
+}
+
+void *profiler_main(void *)
+{
+   prctl(PR_SET_NAME, "winlator-prof", 0, 0, 0);
+   int self = (int)syscall(SYS_gettid);
+   int pid = getpid();
+   long hz = sysconf(_SC_CLK_TCK);
+   if (hz <= 0)
+      hz = 100;
+   static char buf[1024];
+   /* erst kstkeip probieren; liefert der Kernel nur 0, auf Signale umstellen */
+   bool use_signal = false;
+   int sig = SIGRTMAX - 3;
+   unsigned round = 0, probe_samples = 0, probe_nonzero = 0;
+   for (;;) {
+      if (round++ % 50 == 0)
+         prof_refresh(self, hz, buf, sizeof(buf));
+      if (!use_signal && probe_samples >= 200 && !probe_nonzero) {
+         use_signal = install_prof_signal(sig);
+         pthread_mutex_lock(&out_mutex);
+         begin_line();
+         put(use_signal ? "Stichproben: der Kernel liefert keine Programmzähler der Threads, nehme Signal "
+                        : "Stichproben: der Kernel liefert keine Programmzähler der Threads und Signal ");
+         put_dec((unsigned)sig);
+         put(use_signal ? "" : " ist belegt, Profil abgeschaltet");
+         end_line();
+         pthread_mutex_unlock(&out_mutex);
+         pthread_mutex_lock(&prof_mutex);
+         memset(&prof_raster, 0, sizeof(prof_raster));
+         memset(&prof_other, 0, sizeof(prof_other));
+         pthread_mutex_unlock(&prof_mutex);
+         if (!use_signal)
+            return nullptr;
+         probe_nonzero = 1;   /* nicht noch einmal prüfen */
+      }
+      int signalled = 0;
+      for (int i = 0; i < prof_task_count; i++) {
+         if (!prof_tasks[i].sample)
+            continue;
+         char path[48];
+         task_stat_path(path, prof_tasks[i].tid);
+         if (!read_into(path, buf, sizeof(buf)))
+            continue;
+         char state, comm[16];
+         unsigned long long ticks;
+         uintptr_t eip;
+         if (!parse_task_stat(buf, &state, comm, sizeof(comm), &ticks, &eip) || state != 'R')
+            continue;
+         if (use_signal) {
+            /* Thread, der Signale nie annimmt (blockiert), nicht weiter beschießen */
+            if (prof_tasks[i].sent >= 50 && !prof_tasks[i].got)
+               continue;
+            if (!syscall(SYS_tgkill, pid, prof_tasks[i].tid, sig)) {
+               prof_tasks[i].sent++;
+               signalled++;
+            }
+            continue;
+         }
+         if (probe_samples < 200) {
+            probe_samples++;
+            if (eip)
+               probe_nonzero++;
+         }
+         if (!eip)
+            continue;
+         uint64_t key = classify_pc(eip);
+         pthread_mutex_lock(&prof_mutex);
+         prof_count(prof_tasks[i].raster ? prof_raster : prof_other, key, eip);
+         pthread_mutex_unlock(&prof_mutex);
+      }
+      if (use_signal) {
+         /* Mesa blockiert in seinen Threads (u_thread_create) alle Signale: dann einmal melden */
+         static bool blocked_reported;
+         if (!blocked_reported && round % 50 == 49) {
+            bool any_raster = false, all_blocked = true;
+            for (int i = 0; i < prof_task_count; i++) {
+               if (!prof_tasks[i].raster)
+                  continue;
+               any_raster = true;
+               if (prof_tasks[i].sent < 50 || prof_tasks[i].got)
+                  all_blocked = false;
+            }
+            if (any_raster && all_blocked) {
+               blocked_reported = true;
+               pthread_mutex_lock(&out_mutex);
+               begin_line();
+               put("Stichproben: die Mal-Threads blockieren Signal ");
+               put_dec((unsigned)sig);
+               put(" (Mesa sperrt in seinen Threads alle Signale), für sie gibt es kein Profil");
+               end_line();
+               pthread_mutex_unlock(&out_mutex);
+            }
+         }
+         if (signalled)
+            usleep(2000);   /* Handler laufen lassen */
+         for (unsigned k = 0; k < PROF_RING; k++) {
+            int tid = prof_ring[k].tid.exchange(0, std::memory_order_acquire);
+            if (!tid)
+               continue;
+            uintptr_t pc = prof_ring[k].pc;
+            bool raster = false;
+            for (int i = 0; i < prof_task_count; i++) {
+               if (prof_tasks[i].tid == tid) {
+                  raster = prof_tasks[i].raster;
+                  prof_tasks[i].got++;
+                  break;
+               }
+            }
+            uint64_t key = classify_pc(pc);
+            pthread_mutex_lock(&prof_mutex);
+            prof_count(raster ? prof_raster : prof_other, key, pc);
+            pthread_mutex_unlock(&prof_mutex);
+         }
+      }
+      usleep(20000);
+   }
+   return nullptr;
+}
+
+std::atomic<int> profiler_started{0};
+
+void start_profiler()
+{
+   if (!profile_enabled || profiler_started.exchange(1))
+      return;
+   pthread_attr_t attr;
+   pthread_attr_init(&attr);
+   pthread_attr_setdetachstate(&attr, PTHREAD_CREATE_DETACHED);
+   pthread_attr_setstacksize(&attr, 128 * 1024);
+   pthread_t thread;
+   pthread_create(&thread, &attr, profiler_main, nullptr);
+   pthread_attr_destroy(&attr);
+}
