+namespace {
+
+const char hexdigits[] = "0123456789abcdef";
+
+/* ---- Ausgabe zeilenweise auf stderr, ohne malloc ---- */
+
+char line[600];
+size_t line_len;
+
+/* eine Zeile (begin_line .. end_line) bzw. ein ganzer Bericht gehört einem Thread */
+pthread_mutex_t out_mutex = PTHREAD_MUTEX_INITIALIZER;
+
+/* für den Bericht bei Speichermangel: höchstens eine Sekunde warten, dann ohne Sperre */
+bool lock_out_try()
+{
+   for (int i = 0; i < 100; i++) {
+      if (!pthread_mutex_trylock(&out_mutex))
+         return true;
+      usleep(10000);
+   }
+   return false;
+}
+
+void put_char(char c)
+{
+   if (line_len < sizeof(line) - 2)
+      line[line_len++] = c;
+}
+
+void put(const char *s)
+{
+   while (*s)
+      put_char(*s++);
+}
+
+void put_n(const char *s, size_t n)
+{
+   for (size_t i = 0; i < n && s[i]; i++)
+      put_char(s[i]);
+}
+
+void put_dec(unsigned long long v)
+{
+   char tmp[24];
+   int i = 0;
+   do {
+      tmp[i++] = (char)('0' + v % 10);
+      v /= 10;
+   } while (v);
+   while (i)
+      put_char(tmp[--i]);
+}
+
+void put_hex(unsigned long long v, int digits)
+{
+   for (int i = digits - 1; i >= 0; i--)
+      put_char(hexdigits[(v >> (i * 4)) & 15]);
+}
+
+/* Größe lesbar: Byte, KB oder MB */
+void put_size(unsigned long long bytes)
+{
+   if (bytes < 10 * 1024) {
+      put_dec(bytes);
+      put(" B");
+   } else if (bytes < 10ull * 1024 * 1024) {
+      put_dec(bytes >> 10);
+      put(" KB");
+   } else {
+      put_dec(bytes >> 20);
+      put(" MB");
+   }
+}
+
+void begin_line()
+{
+   line_len = 0;
+   put("[diag] ");
+}
+
+void end_line()
+{
+   line[line_len++] = '\n';
+   size_t off = 0;
+   while (off < line_len) {
+      ssize_t r = write(2, line + off, line_len - off);
+      if (r < 0 && errno == EINTR)
+         continue;
+      if (r <= 0)
+         break;
+      off += (size_t)r;
+   }
+   line_len = 0;
+}
+
+/* ---- kleine Dateien aus /proc ---- */
+
+char filebuf[4096];
+
+size_t read_small(const char *path)
+{
+   filebuf[0] = 0;
+   int fd = open(path, O_RDONLY | O_CLOEXEC);
+   if (fd < 0)
+      return 0;
+   size_t n = 0;
+   while (n < sizeof(filebuf) - 1) {
+      ssize_t r = read(fd, filebuf + n, sizeof(filebuf) - 1 - n);
+      if (r < 0 && errno == EINTR)
+         continue;
+      if (r <= 0)
+         break;
+      n += (size_t)r;
+   }
+   close(fd);
+   filebuf[n] = 0;
+   return n;
+}
+
+/* Zahl hinter "Schlüssel:" in filebuf (z. B. "VmSize:  123 kB"), -1 wenn nicht da */
+long long find_value(const char *key)
+{
+   size_t klen = strlen(key);
+   const char *p = filebuf;
+   while (*p) {
+      if (!strncmp(p, key, klen) && p[klen] == ':') {
+         const char *q = p + klen + 1;
+         while (*q == ' ' || *q == '\t')
+            q++;
+         long long v = 0;
+         while (*q >= '0' && *q <= '9')
+            v = v * 10 + (*q++ - '0');
+         return v;
+      }
+      const char *nl = strchr(p, '\n');
+      if (!nl)
+         break;
+      p = nl + 1;
+   }
+   return -1;
+}
+
+/* "Name 123 MB" für einen kB-Wert aus filebuf */
+void put_kb_value(const char *label, const char *key)
+{
+   long long v = find_value(key);
+   if (v < 0)
+      return;
+   put(" ");
+   put(label);
+   put(" ");
+   put_size((unsigned long long)v * 1024);
+}
+
+/* erste Zahl einer kleinen Datei (z. B. /proc/sys/vm/overcommit_memory) */
+void put_file_number(const char *label, const char *path)
+{
+   put(" ");
+   put(label);
+   put(" ");
+   if (!read_small(path)) {
+      put("?");
+      return;
+   }
+   const char *q = filebuf;
+   while (*q >= '0' && *q <= '9')
+      put_char(*q++);
+}
+
+void put_rlimit(const char *label, int resource)
+{
+   struct rlimit rl;
+   put(" ");
+   put(label);
+   put(" ");
+   if (getrlimit(resource, &rl))
+      put("?");
+   else if (rl.rlim_cur == RLIM_INFINITY)
+      put("unbegrenzt");
+   else
+      put_size(rl.rlim_cur);
+}
+
+/* ---- die libGL selbst: Lage des Codes und build-id (beim Laden ermittelt) ---- */
+
+uintptr_t gl_base, gl_text_lo, gl_text_hi;
+char gl_build_id[41];
+
+int find_self_cb(struct dl_phdr_info *info, size_t, void *data)
+{
+   uintptr_t addr = (uintptr_t)data;
+   for (int i = 0; i < info->dlpi_phnum; i++) {
+      const ElfW(Phdr) *ph = &info->dlpi_phdr[i];
+      if (ph->p_type != PT_LOAD || !(ph->p_flags & PF_X))
+         continue;
+      uintptr_t lo = info->dlpi_addr + ph->p_vaddr, hi = lo + ph->p_memsz;
+      if (addr < lo || addr >= hi)
+         continue;
+      gl_base = info->dlpi_addr;
+      gl_text_lo = lo;
+      gl_text_hi = hi;
+      for (int j = 0; j < info->dlpi_phnum; j++) {
+         const ElfW(Phdr) *nh = &info->dlpi_phdr[j];
+         if (nh->p_type != PT_NOTE)
+            continue;
+         const char *p = (const char *)(info->dlpi_addr + nh->p_vaddr);
+         const char *end = p + nh->p_memsz;
+         while (p + sizeof(ElfW(Nhdr)) <= end) {
+            const ElfW(Nhdr) *n = (const ElfW(Nhdr) *)p;
+            const char *name = p + sizeof(*n);
+            const unsigned char *desc = (const unsigned char *)(name + ((n->n_namesz + 3) & ~3u));
+            if (n->n_type == NT_GNU_BUILD_ID && n->n_namesz == 4 && !memcmp(name, "GNU", 4)) {
+               unsigned len = n->n_descsz > 20 ? 20 : n->n_descsz;
+               for (unsigned k = 0; k < len; k++) {
+                  gl_build_id[2 * k] = hexdigits[desc[k] >> 4];
+                  gl_build_id[2 * k + 1] = hexdigits[desc[k] & 15];
+               }
+               gl_build_id[2 * len] = 0;
+            }
+            p = (const char *)desc + ((n->n_descsz + 3) & ~3u);
+         }
+      }
+      return 1;
+   }
+   return 0;
+}
+
+__attribute__((constructor)) void find_self()
+{
+   dl_iterate_phdr(find_self_cb, (void *)&find_self);
+}
+
+/* ---- Adressraum aus /proc/self/maps ---- */
+
+const unsigned SLICE_SHIFT = 24;               /* 16 MB je Zeichen */
+const unsigned SLICES = 256;                   /* 4 GB */
+uint32_t slice_used[SLICES], slice_none[SLICES];
+
+struct range {
+   uintptr_t start, end;
+   char perms[5];
+   char name[40];
+};
+const int TOP = 8;
+range biggest[TOP];
+range gaps[TOP];
+unsigned long long total_mapped, total_none;
+unsigned map_count;
+
+/* Summen je Name (Datei oder "(anonym rw-)"), um viele kleine Bereiche zuordnen zu können */
+struct name_total {
+   char name[40];
+   unsigned long long size;
+   unsigned count;
+};
+const int NAMES = 128;
+name_total names[NAMES];
+int name_count;
+name_total other_names;
+
+void add_name(const char *name, const char *perms, uintptr_t size)
+{
+   char key[sizeof(names[0].name)];
+   memset(key, 0, sizeof(key));
+   if (name[0]) {
+      for (size_t i = 0; i < sizeof(key) - 1 && name[i]; i++)
+         key[i] = name[i];
+   } else {
+      memcpy(key, "(anonym ", 8);
+      memcpy(key + 8, perms, 3);
+      key[11] = ')';
+   }
+   for (int i = 0; i < name_count; i++) {
+      if (!strcmp(names[i].name, key)) {
+         names[i].size += size;
+         names[i].count++;
+         return;
+      }
+   }
+   name_total *t = name_count < NAMES ? &names[name_count++] : &other_names;
+   if (t != &other_names)
+      memcpy(t->name, key, sizeof(key));
+   t->size += size;
+   t->count++;
+}
+uintptr_t prev_end;
+uintptr_t stack_lo, stack_hi, cur_sp;
+
+void insert_top(range *list, const range &r)
+{
+   uintptr_t size = r.end - r.start;
+   for (int i = 0; i < TOP; i++) {
+      if (size > list[i].end - list[i].start) {
+         for (int j = TOP - 1; j > i; j--)
+            list[j] = list[j - 1];
+         list[i] = r;
+         return;
+      }
+   }
+}
+
+uintptr_t parse_hex(const char *&p)
+{
+   uintptr_t v = 0;
+   for (;;) {
+      char c = *p;
+      int d;
+      if (c >= '0' && c <= '9')
+         d = c - '0';
+      else if (c >= 'a' && c <= 'f')
+         d = c - 'a' + 10;
+      else
+         break;
+      v = (v << 4) | (uintptr_t)d;
+      p++;
+   }
+   return v;
+}
+
+void maps_line(const char *p, const char *end)
+{
+   range r;
+   memset(&r, 0, sizeof(r));
+   r.start = parse_hex(p);
+   if (*p != '-')
+      return;
+   p++;
+   r.end = parse_hex(p);
+   if (*p != ' ' || r.end <= r.start)
+      return;
+   p++;
+   for (int i = 0; i < 4 && p < end; i++)
+      r.perms[i] = *p++;
+   /* Offset, Gerät, Inode überspringen, dann der Name */
+   for (int field = 0; field < 3; field++) {
+      while (p < end && *p == ' ')
+         p++;
+      while (p < end && *p != ' ')
+         p++;
+   }
+   while (p < end && *p == ' ')
+      p++;
+   const char *name = p;
+   const char *slash = nullptr;
+   for (const char *q = p; q < end; q++)
+      if (*q == '/')
+         slash = q;
+   if (slash && name[0] == '/')
+      name = slash + 1;
+   size_t nlen = (size_t)(end - name);
+   if (nlen > sizeof(r.name) - 1)
+      nlen = sizeof(r.name) - 1;
+   memcpy(r.name, name, nlen);
+
+   map_count++;
+   uintptr_t size = r.end - r.start;
+   bool none = !strncmp(r.perms, "---", 3);
+   total_mapped += size;
+   if (none)
+      total_none += size;
+   for (uintptr_t a = r.start; a < r.end;) {
+      unsigned s = (unsigned)(a >> SLICE_SHIFT);
+      uintptr_t slice_end = ((uintptr_t)(s + 1)) << SLICE_SHIFT;
+      uintptr_t e = (slice_end == 0 || slice_end > r.end) ? r.end : slice_end;
+      slice_used[s] += (uint32_t)(e - a);
+      if (none)
+         slice_none[s] += (uint32_t)(e - a);
+      if (slice_end == 0)
+         break;
+      a = e;
+   }
+   if (r.start > prev_end) {
+      range g;
+      memset(&g, 0, sizeof(g));
+      g.start = prev_end;
+      g.end = r.start;
+      insert_top(gaps, g);
+   }
+   prev_end = r.end;
+   insert_top(biggest, r);
+   add_name(r.name, r.perms, size);
+   if (cur_sp >= r.start && cur_sp < r.end) {
+      stack_lo = r.start;
+      stack_hi = r.end;
+   }
+}
+
+char mapsbuf[16384];
+
+void scan_maps()
+{
+   int fd = open("/proc/self/maps", O_RDONLY | O_CLOEXEC);
+   if (fd < 0)
+      return;
+   size_t have = 0;
+   for (;;) {
+      ssize_t r = read(fd, mapsbuf + have, sizeof(mapsbuf) - have);
+      if (r < 0 && errno == EINTR)
+         continue;
+      if (r <= 0)
+         break;
+      have += (size_t)r;
+      size_t pos = 0;
+      for (;;) {
+         const char *nl = (const char *)memchr(mapsbuf + pos, '\n', have - pos);
+         if (!nl)
+            break;
+         maps_line(mapsbuf + pos, nl);
+         pos = (size_t)(nl - mapsbuf) + 1;
+      }
+      memmove(mapsbuf, mapsbuf + pos, have - pos);
+      have -= pos;
+      if (have == sizeof(mapsbuf))
+         have = 0; /* überlange Zeile verwerfen */
+   }
+   close(fd);
+}
+
+void put_range(const range &r, bool with_name)
+{
+   put(" ");
+   put_hex(r.start, 8);
+   put("+");
+   put_size(r.end - r.start);
+   if (with_name) {
+      put(" ");
+      put_n(r.perms, 4);
+      if (r.name[0]) {
+         put(" ");
+         put(r.name);
+      }
+   }
+}
+
+/* ---- Rücksprungadressen in die libGL auf dem Stapel ---- */
+
+/* steht vor addr ein Aufruf (BL/BLX)? Thumb-Adressen haben Bit 0 gesetzt */
+bool after_call(uintptr_t addr)
+{
+   if (addr & 1) {
+      uintptr_t pc = addr - 1;
+      if (pc < gl_text_lo + 4 || pc > gl_text_hi)
+         return false;
+      uint16_t hw1 = *(const uint16_t *)(pc - 4), hw2 = *(const uint16_t *)(pc - 2);
+      if ((hw1 & 0xf800) == 0xf000 && (hw2 & 0xc000) == 0xc000)
+         return true; /* BL/BLX mit Sprungziel (32 Bit) */
+      return (hw2 & 0xff87) == 0x4780; /* BLX Rm (16 Bit) */
+   }
+   if (addr & 3 || addr < gl_text_lo + 4 || addr > gl_text_hi)
+      return false;
+   uint32_t insn = *(const uint32_t *)(addr - 4);
+   return (insn & 0x0f000000) == 0x0b000000 || (insn & 0xfe000000) == 0xfa000000 ||
+          (insn & 0x0ffffff0) == 0x012fff30;
+}
+
+/* Rücksprungadressen in die libGL im Stapelbereich [sp, hi) ausgeben (nach dem schon begonnenen
+ * Zeilenanfang), höchstens max, je Zeile per_line; caller zuerst, falls in der libGL */
+int scan_returns(uintptr_t sp, uintptr_t hi, uintptr_t caller, int max, int per_line)
+{
+   /* jede Adresse nur einmal (auf dem Stapel liegen oft alte Kopien) */
+   static uintptr_t seen[64];
+   if (max > 64)
+      max = 64;
+   int shown = 0, in_line = 1;
+   if (caller >= gl_text_lo && caller < gl_text_hi) {
+      put(" ");
+      put_hex(caller - gl_base, 7);
+      seen[shown++] = caller;
+      in_line++;
+   }
+   for (uintptr_t a = sp & ~(uintptr_t)3; a + 4 <= hi && shown < max; a += 4) {
+      uintptr_t w = *(const uintptr_t *)a;
+      if (w < gl_text_lo || w >= gl_text_hi || !after_call(w))
+         continue;
+      bool dup = false;
+      for (int i = 0; i < shown && !dup; i++)
+         dup = seen[i] == w;
+      if (dup)
+         continue;
+      seen[shown] = w;
+      if (in_line == per_line) {
+         end_line();
+         begin_line();
+         put("  ");
+         in_line = 0;
+      }
+      put(" ");
+      put_hex(w - gl_base, 7);
+      shown++;
+      in_line++;
+   }
+   return shown;
+}
+
+void stack_scan(uintptr_t caller)
+{
+   begin_line();
+   put("Aufrufkette (libGL+Offset, neueste zuerst):");
+   if (!gl_text_hi) {
+      put(" libGL nicht gefunden");
+      end_line();
+      return;
+   }
+   uintptr_t hi = stack_hi > cur_sp ? stack_hi : cur_sp + 16384;
+   if (hi - cur_sp > 1024 * 1024)
+      hi = cur_sp + 1024 * 1024;
+   if (!scan_returns(cur_sp, hi, caller, 64, 10))
+      put(" keine gefunden");
+   end_line();
+}
+
+/* ---- Fortschritt: übersetzte Shader, Bilder, Wachhund bei Stillstand ---- */
+
+uint32_t now_ms()
+{
+   struct timespec ts;
+   clock_gettime(CLOCK_MONOTONIC, &ts);
+   return (uint32_t)ts.tv_sec * 1000u + (uint32_t)(ts.tv_nsec / 1000000);
+}
+
+/* Zeit zwischen zwei Zeitpunkten (die Merker sind auf ungerade gerundet, damit 0 "nichts" heißt) */
+uint32_t elapsed(uint32_t from, uint32_t to)
+{
+   return (int32_t)(to - from) > 0 ? to - from : 0;
+}
+
+/* "1234 ms" bzw. "12,3 s" */
+void put_ms(uint32_t ms)
+{
+   if (ms < 10000) {
+      put_dec(ms);
+      put(" ms");
+   } else {
+      put_dec(ms / 1000);
+      put_char(',');
+      put_dec((ms / 100) % 10);
+      put(" s");
+   }
+}
+
+bool progress_enabled = true;        /* WINLATOR_DIAG=0 schaltet ab */
+std::atomic<uint32_t> compiles{0};   /* begonnene Übersetzungen */
+std::atomic<uint32_t> compile_ms_total{0};
+std::atomic<uint32_t> compile_since{0};    /* Beginn der laufenden Übersetzung, 0 = keine */
+std::atomic<uint32_t> compile_nr_now{0};
+char compile_name[48];               /* Name der laufenden Übersetzung (nur zur Ausgabe) */
+std::atomic<uint32_t> frames{0};
+std::atomic<uint32_t> first_compile_ms{0}, last_frame_ms{0};
+thread_local uint32_t tl_compile_t0; /* Beginn in diesem Thread, 0 = keine */
+thread_local uint32_t tl_compile_nr;
+std::atomic<int> watchdog_started{0};
+/* Aufrufe von Beginn/Ende zählen, unabhängig von thread_local (auf dem Gerät kamen keine
+ * Endmeldungen an) */
+std::atomic<uint32_t> compile_end_calls{0}, compile_end_without_begin{0};
+/* Schritt der laufenden Übersetzung (aus lp_bld_init.c/lp_state_fs.c gemeldet) */
+std::atomic<uint32_t> compile_step{0};
+std::atomic<uint32_t> unfinished_reports{0};
+
+const char *step_name(uint32_t step)
+{
+   switch (step) {
+   case 1: return "1 JIT-Engine anlegen";
+   case 2: return "2 Optimierung (Durchlauf 1)";
+   case 3: return "3 Optimierung (Durchlauf 2)";
+   case 4: return "4 Haken eintragen";
+   case 5: return "5 Modul fertig, Instruktionen zählen";
+   case 6: return "6 Maschinencode erzeugen";
+   default: return "?";
+   }
+}
